@model List<demomvc.Models.GiaoVienVM>

@{
    Layout = "~/Views/Shared/Tranhchu_LayoutPage1.cshtml";
}


<link href="~/css/StyleSheet1.css" rel="stylesheet" />
<div class="header-page">
    <a href="@Url.Action("Index","QuanLyGiaoVien")" class="btn-back">
        <i class="fa fa-arrow-left"></i> Quay lại
    </a>

    <h2 class="title">Phân công giảng dạy</h2>
</div>

<div class="container-page">
    <div class="filter-bar">
        <select id="namHoc">
            <option value="">-- Năm học --</option>
            @foreach (var n in ViewBag.NamHoc)
            {
                <option value="@n.NamHocID">@n.TenNamHoc</option>
            }
        </select>

        <select id="hocKy">
            <option value="">-- Học kỳ --</option>
           
        </select>
    </div>

    <div class="table-wrapper">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Giáo viên</th>
                    <th>Môn</th>
                    <th>Phân công</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gv in Model)
                {
                    <tr>
                        <td>@gv.HoTen</td>
                        <td>@gv.TenMonHoc</td>
                        <td class="action-cell">

                            <button class="btn btn-primary"
                                    onclick="showLop(@gv.GiaoVienID)">
                                Chọn lớp
                                <span id="count_@gv.GiaoVienID" class="badge">0</span>
                            </button>

                            <button class="btn btn-success"
                                    onclick="luu(@gv.GiaoVienID)">
                                Lưu
                            </button>

                            <div id="lop_@gv.GiaoVienID" class="dropdown"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- overlay click ngoài -->
    <div id="overlay"></div>
</div>

<!-- toast -->
<div id="toast" class="toast">
    <span id="toastIcon"></span>
    <span id="toastMsg"></span>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function showLop(gvID) {

        let namHoc = $("#namHoc").val();
        let hocKy = $("#hocKy").val();

        if (!namHoc || !hocKy) {
            showToast("Chọn năm học + học kỳ!", "warning");
            return;
        }

        closeAll();
        $("#overlay").show();

        let box = $("#lop_" + gvID);

        $.get("/QuanLyGiaoVien/GetLopByNamHoc",
            {
                namHocId: namHoc,
                hocKyId: hocKy,
                giaoVienId: gvID
            },
            function (res) {

                let html = "";

                res.dsLop.forEach(l => {

                    let checked = res.daChon.includes(l.LopHocID);
                    let isTaken = res.lopBiTrung.includes(l.LopHocID);

                    let cls = "item";
                    if (checked) cls += " selected";
                    else if (isTaken) cls += " disabled";

                    html += `
                        <div class="${cls}">
                            <label>
                                <input type="checkbox"
                                       class="lop_${gvID}"
                                       value="${l.LopHocID}"
                                       ${checked ? "checked" : ""}
                                       ${isTaken ? "disabled" : ""}>
                                ${l.TenLop}
                            </label>
                        </div>`;
                });

                box.html(html).show();
                $("#count_" + gvID).text(res.daChon.length);
            });
    }

    function closeAll() {
        $(".dropdown").hide();
        $("#overlay").hide();
    }

    $("#overlay").click(closeAll);

    $(document).on("click", ".dropdown", function (e) {
        e.stopPropagation();
    });

    $(document).on("click", "input[type=checkbox]", function (e) {
        e.stopPropagation();
    });

    $(document).on("change", "input[type=checkbox]", function () {
        let gvID = $(this).attr("class").split("_")[1];
        let count = $(".lop_" + gvID + ":checked").length;
        $("#count_" + gvID).text(count);
    });

    function luu(gvID) {

        let hocKy = $("#hocKy").val();

        let lopIDs = [];
        $(".lop_" + gvID + ":checked").each(function () {
            lopIDs.push(parseInt($(this).val()));
        });

        $.post("/QuanLyGiaoVien/PhanCongTableAjax",
            {
                giaoVienId: gvID,
                hocKyId: hocKy,
                lopIDs: lopIDs
            },
            function (res) {

                if (res.success) {
                    showToast("Phân công thành công!");
                    closeAll();
                } else {
                    showToast(res.message, "error");
                }
            });
    }

    function showToast(msg, type = "success") {

        let icon = "✅";
        if (type === "error") icon = "❌";
        if (type === "warning") icon = "⚠️";

        $("#toastIcon").text(icon);
        $("#toastMsg").text(msg);

        let toast = $("#toast");

        toast.removeClass("success error warning")
            .addClass(type)
            .addClass("show");

        setTimeout(() => {
            toast.removeClass("show");
        }, 2000);
    }
    $("#namHoc").change(function () {

        let namHocId = $(this).val();

        // reset học kỳ
        $("#hocKy").html('<option value="">-- Học kỳ --</option>');

        if (!namHocId) return;

        $.get("/QuanLyGiaoVien/GetHocKyByNamHoc",
            { namHocId: namHocId },
            function (res) {

                if (res.length === 0) {
                    $("#hocKy").append('<option value="">Chưa có học kỳ</option>');
                    return;
                }

                res.forEach(hk => {
                    $("#hocKy").append(`
                    <option value="${hk.HocKyID}">
                        ${hk.TenHocKy}
                    </option>
                `);
                });
            }
        );
    });

    $("#namHoc").change(function () {
        closeAll();
    });
</script>
