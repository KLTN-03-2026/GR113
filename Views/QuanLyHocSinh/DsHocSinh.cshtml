@model List<demomvc.ViewModel.ThongTinHocSinhVM>
@{
    ViewBag.Title = "DsHocSinh";
    Layout = "~/Views/Shared/Tranhchu_LayoutPage1.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Danh sách học sinh</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #fcfcfc;
            color: #333;
        }

        .header-title {
            color: #2c5d72; /* Màu xanh đen giống ảnh */
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .btn-custom {
            background-color: #39677b;
            color: white;
            border: none;
        }

            .btn-custom:hover {
                background-color: #2c5d72;
                color: white;
            }

        .table-custom thead {
            background-color: #39677b;
            color: white;
        }

        .table-custom th {
            font-weight: normal;
            border-bottom: none;
            padding: 12px;
        }

        .table-custom td {
            padding: 12px;
            vertical-align: middle;
        }

        .search-container {
            max-width: 800px;
            margin: 0 auto 30px auto;
        }
    </style>
</head>
<body>
    @if (TempData["Errors"] != null)
    {
        var errors = TempData["Errors"] as List<string>;
        <div id="errorAlert" class="alert alert-danger">
            <strong>Lỗi khi import:</strong>
            <ul>
                @foreach (var err in errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div id="successAlert" class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    <div class="container-fluid mt-4">
        <div class="d-flex justify-content-start mb-3">
            <a href="@Url.Action("ThemHocSinh","QuanLyHocSinh")" class="btn btn-custom me-2">+ Thêm Mới Học Sinh</a>
            <form action="@Url.Action("UploadFile","QuanLyHocSinh")"
                  method="post"
                  enctype="multipart/form-data"
                  class="d-flex">

                <input type="file" name="file" class="me-2" />

                <button type="submit" class="btn btn-success">
                    Upload
                </button>

            </form>

        </div>

        <div class="text-center">
            <h2 class="header-title">Danh sách học sinh</h2>
        </div>

        <form action=@Url.Action("DsHocSinh","QuanLyHocSinh") method="get" class="search-container d-flex gap-2 justify-content-center">
            <select class="form-select" name="TypeSearch" style="width: auto;">
                <option value="Name">Tìm theo họ tên</option>
                <option value="Id">Tìm theo mã HS</option>
                <option value="Class">Tìm theo lớp</option>
            </select>
            <input type="text" class="form-control" name="Keyword" placeholder="Nhập từ khóa tìm kiếm..." style="flex-grow: 1;">
            <button class="btn btn-custom px-4" type="submit">Tìm kiếm</button>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-custom">
                <thead>
                    <tr>
                        <th>Mã HS</th>
                        <th>Họ tên</th>
                        <th>Tên Lớp</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th>
                        <th>Tỉnh Thành</th>
                        <th>Quận Huyện</th>
                        <th>Địa Chỉ</th>
                        <th>Căn Cước</th>
                        <th>Dân Tộc</th>
                        <th>GVCN</th>
                        <th>Thao Tác</th>

                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaHocSinh</td>
                            <td>@item.HoTen</td>
                            <td>@item.TenLop</td>
                            <td>@item.NgaySinh</td>
                            <td>@item.GioiTinh</td>
                            <td>@item.TinhThanh</td>
                            <td>@item.QuanHuyen</td>
                            <td>@item.DiaChi </td>
                            <td>@item.CCCD</td>
                            <td>@item.DanToc</td>
                            <td>@item.GiaoVienChuNhiem</td>
                            <td>
                                <a href="@Url.Action("Edit", "QuanLyHocSinh", new {id=item.MaHocSinh})">Edit</a>
                                <a href="@Url.Action("Delete", "QuanLyHocSinh",new { id=item.MaHocSinh})">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <script>
    setTimeout(function () {
            let error = document.getElementById("errorAlert");
            if (error) error.style.display = "none";

            let success = document.getElementById("successAlert");
            if (success) success.style.display = "none";
        }, 3000); // 3000ms = 3 giây</script>
</body>
</html>

