@model demomvc.Models.TimLopViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Tranhchu_LayoutPage1.cshtml";

}
<link href="~/css/danhsachlop.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link href="~/css/thongbao.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.6.2/js/bootstrap.min.js"></script>
@*<script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>*@
@*<script src="~/Scripts/jquery-3.7.0.js"></script>*@
<div class="container-fluid">
    <div id="toast" class="toast-message"></div>
    @*<script>
        function showToast(message, isError = false) {
            var toast = document.getElementById("toast");
            toast.innerHTML = message;

            if (isError) {
                toast.classList.add("toast-error");
            } else {
                toast.classList.remove("toast-error");
            }

            toast.classList.add("toast-show");

            setTimeout(function () {
                toast.classList.remove("toast-show");
            }, 3000);
        }*@
    @*? </script>*@
    @if (TempData["Success"] != null)
    {
        <script>
        showToast('@TempData["Success"]', false);
        </script>
    }

    <div class="top-action">
        <a href="@Url.Action("ThemMoiLop", "QuanLyLopHoc")" class="btn btn-primary">
            + Thêm mới lớp học
        </a>
        <a href="@Url.Action("PhanCongChuNhiem", "QuanLyLopHoc")" class="btn btn-primary">
            Phân Công chủ nhiệm
        </a>
        <button class="btn btn-success" data-toggle="modal" data-target="#modalLenLop">
            📈 Lên lớp học sinh
        </button>

    </div>
    <h2>Danh Sách Lớp Theo Năm Học</h2>
    @Html.AntiForgeryToken()

    @using (Html.BeginForm("XemLop", "QuanLyLopHoc", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="table-wrapper">
            <div>
                <label for="NamHocID">Năm học</label>
                @Html.DropDownListFor(
                    m => m.NamHocID,
                    Model.ListNamHoc,
                    "-- Chọn năm học --",
                    new { @class = "form-control", id = "NamHocID" }
                )
                @Html.ValidationMessageFor(m => m.NamHocID, "", new { @class = "text-danger" })
            </div>

            <button class="btn btn-primary" type="submit">Xem</button>
        </div>

    }


    @if (Model.ListLop != null && Model.ListLop.Count > 0)
    {
        <h3 class="mt-4">Danh sách lớp:</h3>

        <table class="table table-bordered table-striped">
            <thead style="background:#2f5f73;color:white;">
                <tr>
                    <th>Tên lớp</th>
                    <th>Giáo viên chủ nhiệm</th>
                    <th>Sĩ số</th>
                    <th>Khối </th>
                    <th>Ca học</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.ListLop)
                {
                    <tr>
                        <td data-label="Tên lớp">@item.TenLop</td>
                        <td data-label="Giáo viên">@item.GiaoVienChuNhiem</td>
                        <td data-label="Sĩ số">@item.SiSo</td>
                        <td data-label="Khối lớp">@item.TenKhoi</td>
                        <td data-label="Ca học">@item.CaHoc</td>
                        <td data-label="Trạng thái">@item.TrangThaiNamHoc</td>
                        <td data-label="Hành động">
                            <!-- Nút Cập nhật: chuyển sang trang cập nhật -->
                            <a href="@Url.Action("CapNhatLop", "QuanLyLopHoc", new { id = item.LopHocID })"
                               class="btn btn-sm btn-primary me-2">
                                Cập nhật
                            </a>

                            <button type="button" class="btn-delete" data-id="@item.LopHocID">
                                <i class="fa fa-trash"></i> Xóa
                            </button>

                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }
    else if (Model.NamHocID > 0)
    {
        <p style="color:red; margin-top:20px;">Không có lớp nào trong năm học này.</p>
    }
</div>
<div class="modal fade" id="modalLenLop"  style="margin-top:60px;">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">📈 Lên lớp học sinh</h5>
                @*<button type="button" class="close" data-dismiss="modal">&times;</button>*@
            </div>

            <div class="modal-body">
                <label>Năm học cũ</label>
                <select id="namHocCu" class="form-control mb-2">
                    <option value="">-- Chọn năm học --</option>
                    @foreach (var item in Model.ListNamHoc)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>

                <label>Năm học mới</label>
                <select id="namHocMoi" class="form-control mb-2">
                    <option value="">-- Chọn năm học --</option>
                    @foreach (var item in Model.ListNamHoc)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="modal-footer">
                <button class="btn btn-success" onclick="lenLop()">✅ Chuyển</button>
                <button class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>

        </div>
    </div>
</div>
<script>
    $(document).on("click", ".btn-delete", function () {

        var btn = $(this);
        var id = btn.attr("data-id");

        console.log("ID:", id);

        if (!id) {
            alert("Không có ID!");
            return;
        }

        if (!confirm("Xóa lớp này?")) return;

        btn.prop("disabled", true);
        btn.text('Đang xóa...');

        $.ajax({
            url: '/QuanLyLopHoc/Deletelop',
            type: 'POST',   // ✅ ĐÚNG CHỖ
            data: {
                id: id,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            },

            success: function (res) {
                console.log("OK:", res);

                if (res.ok) {
                    alert("Xóa thành công");
                    btn.closest("tr").remove();
                } else {
                    alert(res.msg);
                    btn.prop("disabled", false);
                    btn.text("Xóa");
                }
            },

            error: function (err) {
                console.log("Lỗi:", err);
                alert("Lỗi hệ thống");
                btn.prop("disabled", false);
                btn.text("Xóa");
            }
        });
    });
    function lenLop() {

        var namHocCu = $("#namHocCu").val();
        var namHocMoi = $("#namHocMoi").val();

        if (!namHocCu || !namHocMoi) {
            alert("❌ Vui lòng chọn đầy đủ năm học!");
            return;
        }

        // ✅ CHẶN NĂM HỌC MỚI <= NĂM CŨ
        if (parseInt(namHocMoi) <= parseInt(namHocCu)) {
            alert("❌ Năm học mới phải LỚN HƠN năm học cũ!");
            return;
        }

        if (!confirm("Bạn có chắc muốn lên lớp học sinh?")) return;

        $.ajax({
            url: '/QuanLyLopHoc/LenLop',
            type: 'POST',
            data: {
                namHocCu: namHocCu,
                NamHocMoi: namHocMoi
            },
            success: function (res) {
                alert(res.message);
                if (res.success) {
                    $("#modalLenLop").modal("hide");
                    location.reload();
                }
            },
            error: function () {
                alert("❌ Lỗi hệ thống!");
            }
        });
    }
    

</script>

