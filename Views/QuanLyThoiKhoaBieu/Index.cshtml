    $("#NamHocID").change(function () {

    var namHocID = $(this).val();
    if (!namHocID) return;

    $.ajax({
        url: '@Url.Action("GetHocKyByNamHoc", "QuanLyThoiKhoaBieu")',
        type: 'GET',
        data: { namHocID: namHocID },
        success: function (data) {

            var hocKyDropdown = $("#HocKyID");

            hocKyDropdown.empty(); // xoá cũ

            hocKyDropdown.append('<option value="">-- Chọn học kỳ --</option>');

            if (data.length === 0) {
                hocKyDropdown.append('<option value="">Chưa có học kỳ</option>');
                return;
            }

            $.each(data, function (i, item) {
                hocKyDropdown.append(
                    '<option value="' + item.id + '">' + item.text + '</option>'
                );
            });

            //  auto chọn cái đầu
            hocKyDropdown.val(data[0].id);
        },
        error: function () {
            showToast("Không load được học kỳ", "error");
        }
        
    });
    });
    //---------------------
    $('#loaiNghi').change(function () {
        let loai = $(this).val();

        if (loai === "ngay") {
            $('#boxNgay').show();
            $('#boxTiet').hide();
        } else {
            $('#boxNgay').hide();
            $('#boxTiet').show();
        }
    });


    let fpNgayNghi;

    $(document).ready(function () {
        initFlatpickr();
    });


    function resetModalNghiHoc() {
        $('#loaiNghi').val('ngay');

        $('#boxNgay').show();
        $('#boxTiet').hide();

        if (fpNgayNghi) {
            fpNgayNghi.clear();
            fpNgayNghi.close();//  đúng
        }

        $('#ngayNghiTiet').val('');
        $('.chkTiet').prop('checked', false);
    }

    $('#modalNghiHoc').on('hidden.bs.modal', function () {
        resetModalNghiHoc();
    });

    function initFlatpickr() {
        if (fpNgayNghi) {
            fpNgayNghi.destroy();
        }

        fpNgayNghi = flatpickr("#txtNgayNghi", {
            mode: "multiple",
            dateFormat: "Y-m-d",
            locale: "vn",
            minDate: "today",
            disable: [
                function (date) {
                    return date.getDay() === 0;
                }
            ]
        });
    }
    $('#modalNghiHoc').on('hidden.bs.modal', function () {
        resetModalNghiHoc();
    });
    $(document).on('click', '[data-dismiss="modal"]', function () {
        if ($(this).closest('#modalNghiHoc').length) {
            setTimeout(() => {
                resetModalNghiHoc();
            }, 100);
        }
    });
    $('#modalNghiHoc').on('click', function (e) {
        if ($(e.target).hasClass('modal')) {
            setTimeout(() => {
                resetModalNghiHoc();
            }, 100);
        }
    });
</script>