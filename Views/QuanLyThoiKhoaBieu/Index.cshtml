        $('#addThu').val(thu);
        $('#addTiet').val(tiet);
        $('#addTuan').val(tuan);

        $('#addInfo').text(
            'Tuần ' + tuan + ' - Thứ ' + thu + ' - Tiết ' + tiet
        );

        $.get('@Url.Action("GetEditData")', {
            namHocId: @Model.NamHocID,
            hocKyId: @Model.HocKyID
        }, function (res) {

            fillSelect($('#addLop'), res.lops, null);
            fillSelect($('#addMon'), res.mons, null);
            fillSelect($('#addGV'), res.gvs, null);
            fillSelect($('#addPhong'), res.phongs, null);

            $('#modalAddTKB').modal('show');
        });
    });*@
        $(document).on('click', '.btn-add-tkb', function (e) {

        e.stopPropagation();

        console.log("CLICK ADD OK");

        let thu = $(this).data('thu');
        let tiet = $(this).data('tiet');
        let tuan = $(this).data('tuan');

        $('#addThu').val(thu);
        $('#addTiet').val(tiet);
        $('#addTuan').val(tuan);

        $('#addInfo').text(
            'Tuần ' + tuan + ' - Thứ ' + thu + ' - Tiết ' + tiet
        );

        // 👉 mở modal NGAY
        $('#modalAddTKB').modal('show');

        // 👉 load dữ liệu sau
        $.get('@Url.Action("addGetData")', {
            namHocId: @Model.NamHocID,
            hocKyId: @Model.HocKyID,
            thu: thu,
            tuan: tuan,
            tiet: tiet
        }, function (res) {
            fillSelectAdd($('#addLop'), res.lopHoc, '-- Vui lòng chọn lớp --');
            fillSelectAdd($('#addMon'), res.monHoc, '-- Vui lòng chọn môn học --');
            fillSelectAdd($('#addGV'), res.giaoVien, '-- Vui lòng chọn giáo viên --');
            fillSelectAdd($('#addPhong'), res.phongHoc, '-- Vui lòng chọn phòng học --');


        });

        });

    function resetAddModal() {
        $('#addLop').empty();
        $('#addMon').empty();
        $('#addGV').empty();
        $('#addPhong').empty();
    }

    $(document).on('change', '#addMon', function () {

        let monId = $(this).val();

        $.get('@Url.Action("GetGVByMon")', {
            monHocId: monId
        }, function (res) {

            fillSelect($('#addGV'), res, null);

        });

    });



// ===== CLICK THÊM =====
    $(document).on('click', '#btnAddTKB', function () {

        let data = {

Thu: $('#addThu').val(),
            TietHoc: $('#addTiet').val(),
            Tuan: $('#addTuan').val(),

            LopHocId: $('#addLop').val(),
            MonHocId: $('#addMon').val(),
            GiaoVienId: $('#addGV').val(),
            PhongHocID: $('#addPhong').val(),

            NamHocID: @Model.NamHocID,
            HocKyID: @Model.HocKyID

        };
        console.log(data);
        $.post('@Url.Action("addTKB")', data, function (res) {

            if (!res.oke) {
                alert(res.msg);
                return;
            }

            alert("Thêm thành công");

            $('#modalAddTKB').modal('hide');

            reloadTKB();
        });

    });

    $('#modalAddTKB').on('hidden.bs.modal', function () {
        $('#addLop, #addMon, #addGV, #addPhong').val('');
    });
    $('#modalAddTKB').on('hidden.bs.modal', function () {
        resetAddModal();
    });
</script>