<!--chon ngay bat dau hoc-->
@if (Model.HocKyID > 0)
{
    <div class="card mb-3 border-info" style="margin-top:10px;">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div>
                <i class="fa fa-calendar-alt text-info"></i>
                <b>Ngày bắt đầu học:</b>
                <span id="lblNgayBatDauHoc"
                      class="ms-1 @(Model.NgayBatDauHoc.HasValue ? "text-primary" : "text-danger")">
                    @(Model.NgayBatDauHoc.HasValue
                    ? Model.NgayBatDauHoc.Value.ToString("dd/MM/yyyy")
                    : "Chưa thiết lập")
                </span>

            </div>


            <button class="btn btn-sm btn-outline-info"
                    data-bs-toggle="modal"
                    data-bs-target="#modalSetNgayBatDauHoc">

                ✏ Chọn / Sửa
            </button>
        </div>
    </div>
}
<div class="modal fade" id="modalSetNgayBatDauHoc" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Chọn ngày bắt đầu học</h5>
                <button type="button" class="close" onclick="closeModalSetNgay()">
                    &times;
                </button>

            </div>

            <div class="modal-body">
                <label>📅 Ngày bắt đầu học</label>
                <input type="date" id="txtNgayBatDauHoc"
                       class="form-control"
                       value="@(Model.NgayBatDauHoc?.ToString("yyyy-MM-dd"))">
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary"
                        id="btnSaveNgayBatDauHoc">
                    💾 Lưu
                </button>
            </div>

        </div>
    </div>
</div>

<!--set ngay nghi-->
<div class="modal fade" id="modalNghiHoc">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">📛 Nghỉ học</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">
                <label>📅 Ngày nghỉ</label>
                <!--  <input type="date" id="txtNgayNghi" class="form-control"> -->

                <input type="text"
                       id="txtNgayNghi"
                       class="form-control"
                       placeholder="Chọn nhiều ngày...">


            </div>

            <div class="modal-footer">
                <button class="btn btn-danger" id="btnXacNhanNghi">✅ Nghỉ học</button>
            </div>

        </div>
    </div>
</div>

@if (Model.ThoiKhoaBieus != null)
{
    <hr />
    <!-- HEADER TUẦN -->
    <div class="alert alert-danger fw-bold">
        📅 Lịch học Tuần @Model.Tuan
    </div>

    <!-- NÚT CA + NÚT NEXT -->
    <div class="d-flex justify-content-between mb-3">
        <div>
            <button class="btn btn-primary me-2"
                    onclick="doiCa('Sang')">
                ☀️ Ca sáng
            </button>

            <button class="btn btn-warning"
                    onclick="doiCa('Chieu')">
                🌙 Ca chiều
            </button>

            <button class="btn btn-outline-danger"
                    data-toggle="modal"
                    data-target="#modalNghiHoc">
                📛 Nghỉ học
            </button>

        </div>

        <div>

            <button class="btn btn-secondary me-2"
                    onclick="prevWeek()">
                ⬅ Tuần trước
            </button>

            <button class="btn btn-secondary"
                    onclick="nextWeek()">
                Tuần tiếp theo ➡
            </button>
        </div>
    </div>

    <div class="tkb-container">
        <!-- BẢNG TKB -->

        <table class="table table-bordered text-center align-middle">
            <thead>
                <tr>
                    <th rowspan="2"></th>


                    @for (int thu = 2; thu <= 8; thu++)
                    {

                        <th>Thứ @(thu == 8 ? "CN" : thu.ToString())</th>
                    }
                </tr>

                <tr>
                    @{
                        if (Model.NgayBatDauHoc.HasValue)
                        {
                            DateTime start = Model.NgayBatDauHoc.Value;

                            // ✅ TÍNH THỨ 2 THEO ISO (QUỐC TẾ)
                            int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                            DateTime mondayOfWeek = start.AddDays(-diff);

                            // ✅ CỘNG TUẦN (nếu xem tuần > 1)
                            mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                            for (int i = 0; i < 7; i++)
                            {
                                @*<th>@mondayOfWeek.AddDays(i).ToString("dd/MM/yyyy")</th>*@

                                DateTime today = DateTime.Now.Date;
                                DateTime day = mondayOfWeek.AddDays(i).Date;


                                <th class="@(day == today ? "today-col" : "")">
                                    @day.ToString("dd/MM/yyyy")
                                </th>
                            }
                        }
                        else
                        {
                            for (int i = 0; i < 7; i++)
                            {
                                <th>--/--/----</th>
                            }
                        }
                    }
                </tr>

            </thead>

            <tbody>
                @for (int tiet = 1; tiet <= 10; tiet++)
                {

                    if (tiet == 6)
                    {
                        <tr class="row-ca-chuyen">
                            <td colspan="8">
                                🌙 Buổi chiều (Tiết 6 → 10)
                            </td>
                        </tr>
                    }

                    <tr>
                        <td><b>Tiết @tiet</b></td>

                        @for (int thu = 2; thu <= 8; thu++)
                        {


                            DateTime today = DateTime.Now.Date;

                            DateTime start = Model.NgayBatDauHoc.Value;

                            int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                            DateTime mondayOfWeek = start.AddDays(-diff);

                            mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                            int index = thu - 2;
                            DateTime day = mondayOfWeek.AddDays(index).Date;

                            //var list = Model.ThoiKhoaBieus
                            //        .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            //        .ToList();

                            var list = Model.ThoiKhoaBieus
                            .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            .ToList();
                            //theem moi----------------------------------------

                            bool laNgayNghi = Model.DsNgayNghi != null
                                            && Model.DsNgayNghi.Any(n => n.Thu == thu);
                            //--------------------------------------------

                            bool laSang = Model.CaHoc == "Sang";

                            bool isChaoCo =
                                thu == 2 &&
                                ((laSang && tiet == 1) || (!laSang && tiet == 10));

                            bool isSinhHoat =
                                thu == 7 &&
                                ((laSang && tiet == 5) || (!laSang && tiet == 10));


                            //<td class="text-start position-relative">
                            <td class="text-start position-relative @(day == today ? "today-col" : "")">

                                @{

                                    var hocBu = Model.DsHocBu?
                                        .FirstOrDefault(x =>
                                        {
                                            var ngayHocBu = Model.DsNgayHoc
                                        .FirstOrDefault(n => n.NgayHocID == x.NgayHocBuID);

                                            return ngayHocBu != null
                                        && ngayHocBu.Tuan == Model.Tuan
                                        && ngayHocBu.Thu == thu;
                                        });
                                }

                                @if (hocBu != null)
                                {
                                    var ngayHocBu = Model.DsNgayHoc
                                        .FirstOrDefault(n => n.NgayHocID == hocBu.NgayHocBuID);

                                    var ngayNghi = Model.DsNgayHoc
                                        .FirstOrDefault(n => n.NgayHocID == hocBu.NgayNghiID);

                                    if (ngayHocBu != null && ngayNghi != null)
                                    {
                                        var listCurrent = Model.ThoiKhoaBieus
                                                   .Where(x => x.Thu == thu && x.TietHoc == tiet)
                                                   .ToList();


                                        var listHocBu = new List<demomvc.Models.ThoiKhoaBieu>();

                                        using (var db2 = new demomvc.Models.QuanLyTruongHocEntities1())
                                        {
                                            listHocBu = db2.ThoiKhoaBieu

                                                        .Include("PhongHoc")
                                                        .Include("LopHoc")
                                                        .Include("MonHoc")
                                                        .Include("GiaoVien.NguoiDung")

                                                        .Where(x =>
                                                            x.NamHocID == Model.NamHocID &&
                                                            x.HocKyID == Model.HocKyID &&
                                                            x.Tuan == ngayNghi.Tuan &&   //  tuần gốc
                                                            x.Thu == ngayNghi.Thu &&
                                                            x.TietHoc == tiet &&

                                                                (
                                                                       (Model.CaHoc == "Sang" && x.LopHoc.CaHoc == "SANG") ||
                                                                       (Model.CaHoc == "Chieu" && x.LopHoc.CaHoc == "CHIEU")
                                                                )

                                                        )
                                                        .ToList();
                                        }
                                        <div class="tkb-add btn-add-tkb"
                                             data-thu="@thu"
                                             data-tiet="@tiet"
                                             data-tuan="@Model.Tuan">
                                            <i class="fa fa-plus"></i>
                                            <span class="tkb-tooltip">Thêm tiết học</span>
                                        </div>
                                        //TKB goc

                                        // ✅ 1. HIỆN TKB TUẦN HIỆN TẠI (QUAN TRỌNG)
                                        foreach (var item in listCurrent)
                                        {
                                            <div class="tkb-item tkb-click"
                                                 data-id="@item.TKBID"
                                                 data-lopid="@item.LopHocID"
                                                 data-lopten="@item.LopHoc.TenLop"
                                                 data-monid="@item.MonHocID"
                                                 data-monten="@item.MonHoc.TenMonHoc"
                                                 data-gvid="@item.GiaoVienID"
                                                 data-gvten="@item.GiaoVien.NguoiDung.HoTen"
                                                 data-phongid="@item.PhongHocID"
                                                 data-phongten="@item.PhongHoc.TenPhong"
                                                 data-thu="@thu" // ✅ FIX
                                                 data-tiet="@item.TietHoc"
                                                 data-tuan="@Model.Tuan">


                                                <b>@item.PhongHoc.TenPhong</b><br />
                                                Lớp: <b>@item.LopHoc.TenLop</b><br />
                                                Môn học: @item.MonHoc.TenMonHoc<br />
                                                GV: @item.GiaoVien.NguoiDung.HoTen
                                            </div>
                                        }
                                        foreach (var item in listHocBu)
                                        {
                                            <div class="tkb-item tkb-click"
                                                 data-id="@item.TKBID"
                                                 data-lopid="@item.LopHocID"
                                                 data-lopten="@item.LopHoc.TenLop"
                                                 data-monid="@item.MonHocID"
                                                 data-monten="@item.MonHoc.TenMonHoc"
                                                 data-gvid="@item.GiaoVienID"
                                                 data-gvten="@item.GiaoVien.NguoiDung.HoTen"
                                                 data-phongid="@item.PhongHocID"
                                                 data-phongten="@item.PhongHoc.TenPhong"
                                                 data-thu="@item.Thu"
                                                 data-tiet="@item.TietHoc"
                                                 data-tuan="@item.Tuan">

                                                <b>@item.PhongHoc.TenPhong</b><br />
                                                Lớp: <b>@item.LopHoc.TenLop</b><br />
                                                Môn học: @item.MonHoc.TenMonHoc<br />
                                                GV: @item.GiaoVien.NguoiDung.HoTen
                                            </div>
                                        }
                                    }
                                }

                                else if (laNgayNghi)
                                {


                                    <div class="tkb-nghi tkb-bo-nghi"
                                         data-thu="@thu"
                                         data-tuan="@Model.Tuan"
                                         title="Click để mở lại ngày học">
                                        🚫 NGHỈ HỌC (bỏ nghỉ)
                                    </div>

                                }
                                else
                                {
                                    <!--Dau cong them tiet-->
                                    <div class="tkb-add btn-add-tkb"
                                         data-thu="@thu"
                                         data-tiet="@tiet"
                                         data-tuan="@Model.Tuan">
                                        <i class="fa fa-plus"></i>
                                        <span class="tkb-tooltip">Thêm tiết học</span>
                                    </div>

                                    if (isChaoCo || isSinhHoat)
                                    {
                                        <div class="tkb-item">

                                            @if (isChaoCo)
                                            {
                                                <div>⭐ Chào cờ</div>
                                            }
                                            @if (isSinhHoat)
                                            {
                                                <div>⭐ Sinh hoạt lớp</div>
                                            }
                                        </div>
                                    }

                                    else
                                    {
                                        foreach (var item in list)
                                        {
                                            <div class="tkb-item tkb-click"
                                                 data-id="@item.TKBID"
                                                 data-lopid="@item.LopHocID"
                                                 data-lopten="@item.LopHoc.TenLop"
                                                 data-monid="@item.MonHocID"
                                                 data-monten="@item.MonHoc.TenMonHoc"
                                                 data-gvid="@item.GiaoVienID"
                                                 data-gvten="@item.GiaoVien.NguoiDung.HoTen"
                                                 data-phongid="@item.PhongHocID"
                                                 data-phongten="@item.PhongHoc.TenPhong"
                                                 data-thu="@item.Thu"
                                                 data-tiet="@item.TietHoc"
                                                 data-tuan="@item.Tuan">



                                                <b>@item.PhongHoc.TenPhong</b><br />
                                                Lớp: <b>@item.LopHoc.TenLop</b><br />
                                                Môn học: @item.MonHoc.TenMonHoc<br />
                                                GV: @item.GiaoVien.NguoiDung.HoTen
                                            </div>

                                        }
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


