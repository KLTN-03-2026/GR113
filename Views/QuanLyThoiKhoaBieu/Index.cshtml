   $('#btnSaveNgayBatDauHoc').click(function () {

    let ngay = $('#txtNgayBatDauHoc').val();
    if (!ngay) {
        alert("Vui lòng chọn ngày bắt đầu học");
        return;
    }

    $.post('@Url.Action("SetNgayBatDauHoc")', {
        namHocId: @Model.NamHocID,
        hocKyId: @Model.HocKyID,
        ngayBatDauHoc: ngay
    }, function (res) {

        if (!res.oke) {
            alert(res.msg);
            return;
        }

        // format yyyy-MM-dd -> dd/MM/yyyy
        let p = ngay.split('-');
        let ngayHienThi = p[2] + '/' + p[1] + '/' + p[0];

        //  cập nhật ngay – KHÔNG reload
        $('#lblNgayBatDauHoc')
            .text(ngayHienThi)
            .removeClass('text-danger')
            .addClass('text-primary');

        alert(res.msg);

        //  đóng modal
        $('#modalSetNgayBatDauHoc').modal('hide');
    });
   });


    function prevWeek() {

        let tuan = @Model.Tuan;  // lấy từ Razor

        tuan = tuan - 1;

        // ✅ chặn tại đây
        if (tuan < 1) {
            tuan = 1;
        }

        window.location.href =
            '@Url.Action("Index")'
            + '?NamHocID=@Model.NamHocID'
            + '&HocKyID=@Model.HocKyID'
            + '&tuan=' + tuan
            + '&caHoc=@Model.CaHoc';
    }

    $('#btnXacNhanNghi').click(async function () {

    let loai = $('#loaiNghi').val();

    // ✅ NGHỈ THEO NGÀY
    if (loai === "ngay") {

    let raw = $('#txtNgayNghi').val();

    if (!raw) {
        alert("❗ Vui lòng chọn ít nhất 1 ngày");
        return;
    }

    let ngayList = raw.split(",");
    ngayList = [...new Set(ngayList)];

    for (let ngay of ngayList) {
        await $.ajax({
            url: '@Url.Action("DatNgayNghi")',
            type: 'POST',
            data: {
                namHocId: @Model.NamHocID,
                hocKyId: @Model.HocKyID,
                ngayNghi: ngay.trim()
            }
        });
    }

    alert("✅ Đã nghỉ theo ngày");
}

    // ✅ NGHỈ THEO TIẾT
   else {

    let ngay = $('#ngayNghiTiet').val();

    if (!ngay) {
        alert("Vui lòng chọn ngày");
        return;
    }

    let tietList = [];

    $(".chkTiet:checked").each(function () {
        tietList.push(parseInt($(this).val()));
    });

    if (tietList.length === 0) {
        alert("Vui lòng chọn tiết");
        return;
    }

    // ✅ GỌI TUẦN TỰ (ANTI NGHẼN + KHÔNG LỖI)
    for (let tiet of tietList) {

        try {

            let res = await new Promise((resolve, reject) => {
                $.ajax({
                    url: '@Url.Action("DatTietNghi")',
                    type: 'POST',
                    data: {
                        namHocId: @Model.NamHocID,
                        hocKyId: @Model.HocKyID,
                        ngayNghi: ngay,
                        tietHoc: tiet
                    },
                    success: resolve,
                    error: reject
                });
            });

            if (!res.oke) {
                console.log("❌ Lỗi tiết " + tiet + ": " + res.msg);
            } else {
                console.log("✅ OK tiết " + tiet);
            }

        } catch (err) {
            console.log("❌ API fail tiết " + tiet);
        }

        // ✅ delay nhẹ để tránh nghẽn server (rất quan trọng)
        await new Promise(r => setTimeout(r, 150));
    }

    alert("✅ Đã nghỉ các tiết đã chọn");    
        setTimeout(() => {

            // ✅ đóng modal mạnh tay
            $('#modalNghiHoc').removeClass('show');
            $('#modalNghiHoc').css('display', 'none');

            // ✅ remove backdrop (cái này mới là thủ phạm)
            $('.modal-backdrop').remove();

            // ✅ reset body
            $('body').removeClass('modal-open');
            $('body').css('padding-right', '');

            // ✅ reload lại bảng
            reloadTKB();

            // ✅ enable nút lại
            $('#btnXacNhanNghi').prop('disabled', false);

        }, 200);
});

$(document).on('click', '.tkb-bo-nghi', function () {

    if (!confirm("Bạn muốn bỏ nghỉ?")) return;

    let thu = $(this).data('thu');
    let tuan = $(this).data('tuan');
    let tiet = $(this).data('tiet'); // có hoặc không

    $.post('@Url.Action("BoNgayNghi")', {
        namHocId: @Model.NamHocID,
        hocKyId: @Model.HocKyID,
        tuan: tuan,
        thu: thu,
        tietHoc: tiet || null   // ✅ phân biệt ngày vs tiết
    }, function (res) {

        if (!res.oke) {
            alert(res.msg);
            return;
        }
        alert("✅ Đã bỏ nghỉ");
        reloadTKB();
    });
});
    //nút x chon ngay học
    function closeModalSetNgay() {
        $('#modalSetNgayBatDauHoc').modal('hide');

        // fallback (tránh bị kẹt overlay)
        $('#modalSetNgayBatDauHoc').hide();
