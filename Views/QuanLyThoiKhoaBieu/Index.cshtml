            //};
            hub.client.updateProgress = function (message) {

                // text status
                $("#aiText").text(message);

                // log terminal
                $('#aiLog').prepend(`
        <div style="margin-bottom:6px;">
            > ${message}
        </div>
    `);

                // ===== AI HOÀN TẤT =====
                if (message.includes("Hoàn tất")) {

                    // text đẹp
                    $("#aiText").text("✅ chờ trong giây lát nhé");

                    // progress full
                    $(".ai-progress-bar").css({
                        width: "100%",
                        transition: "1s ease"
                    });

                    // terminal đẹp hơn
                    $('#aiLog').prepend(`
            <div style="color:#00ffcc;">
                > Completed successfully ✅
            </div>
        `);

                    // delay cho user thấy hoàn tất
                    setTimeout(function () {
                        location.reload();
                    }, 400);
                }
            };

            $.connection.hub.start();

        } catch (e) {
            console.warn("SignalR error:", e);
        }
    }

    // ===== SUBMIT =====
    //function onSubmitTKB() {
    //    $("#btnSubmit").prop("disabled", true);
    //    $("#aiOverlay").css("display", "flex");
    //    $("#aiText").text("AI đang khởi tạo...");
    //    return true;
    //}
    let isSubmittingTKB = false;

    function onSubmitTKB() {

        // ✅ submit thật -> cho chạy luôn
        if (isSubmittingTKB) {
            return true;
        }

        Swal.fire({
            title: 'Tạo thời khóa biểu?',
            html: `
            <div style="font-size:15px;color:#555">
                AI sẽ tự động xếp thời khóa biểu cho toàn trường.<br>
                Quá trình này có thể mất vài phút.
            </div>
        `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '🚀 Bắt đầu tạo',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#d33',
            reverseButtons: true,
            allowOutsideClick: false
        }).then((result) => {

            if (result.isConfirmed) {

                // ✅ đánh dấu đang submit thật
                isSubmittingTKB = true;

                // disable nút
                $("#btnSubmit").prop("disabled", true);

                // overlay AI như code cũ
                $("#aiOverlay").css("display", "flex");

                $("#aiText").text("🤖 AI đang khởi tạo...");

                // submit thật
                $("#formTKB")[0].submit();
            }
        });

        return false;
    }

    // ===== CHUYỂN CA =====
    function doiCa(ca) {
        window.location.href =
            '@Url.Action("Index")'
            + '?NamHocID=@Model.NamHocID'
            + '&HocKyID=@Model.HocKyID'
            + '&tuan=@Model.Tuan'
            + '&caHoc=' + ca;
    }

    // ===== TUẦN TIẾP =====
    function nextWeek() {
        window.location.href =
            '@Url.Action("Index")'
            + '?NamHocID=@Model.NamHocID'
            + '&HocKyID=@Model.HocKyID'
            + '&tuan=' + (@Model.Tuan + 1)
            + '&caHoc=@Model.CaHoc';
    }

    // ===== CLICK Ô TKB =====
       $(document).ready(function () {

            $(document).on('click', '.tkb-click', function () {

                console.log("CLICK OK");

                let t = $(this);

                $('#editTKBId').val(t.data('id'));

                $('#tkbInfo').text(
                    'Tuần ' + t.data('tuan') +
                    ' - Thứ ' + t.data('thu') +
                    ' - Tiết ' + t.data('tiet')
                );

                $.get('@Url.Action("GetEditData")', {
                    namHocId: @Model.NamHocID,
                    hocKyId: @Model.HocKyID,
                    lopHocId: t.data('lopid'),
                     monHocId: t.data('monid')
                }, function (res) {

                    fillSelect($('#editLop'), res.lops, t.data('lopid'));
                    fillSelect($('#editMon'), res.mons, t.data('monid'));
                    fillSelect($('#editGV'), res.gvs, t.data('gvid'));
                    fillSelect($('#editPhong'), res.phongs, t.data('phongid'));

                    //  Bootstrap 4
                    $('#modalEditTKB').modal('show');
                });
            });

       });

    $('#editMon').change(function () {

        let monId = $(this).val();

        $.get('@Url.Action("GetEditData")', {
            namHocId: @Model.NamHocID,
            hocKyId: @Model.HocKyID,
            lopHocId: $('#editLop').val(),
            monHocId: monId
        }, function (res) {

            // chỉ update giáo viên thôi
            fillSelect($('#editGV'), res.gvs, null);
        });
    });

    // ===== SAVE =====
       $(document).on('click', '#btnSaveTKB', function () {

        console.log("CLICK SAVE");

        let data = {
            TKBID: $('#editTKBId').val(),
            LopHocId: $('#editLop').val(),
            GiaoVienId: $('#editGV').val(),
            MonHocId: $('#editMon').val(),
            PhongHocID: $('#editPhong').val()
        };

        $.post('@Url.Action("UpdateTKB")', data, function (res) {

            console.log(res);

            if (!res.oke) {
                alert(res.msg);
                return;
            }

            alert("Cập nhật thành công");

            $('#modalEditTKB').modal('hide'); // ✅ đúng bootstrap 4

            reloadTKB();
        });
    });

    // ===== DELETE =====
    $(document).on('click', '#btnDeleteTKB', function () {
        let id = $('#editTKBId').val();

        if (!id) {
            alert("Không có tiết để xóa");
            return
        }

        if (!confirm("Bạn Chắc chắn muốn xóa tiết này không.")) return;

        $.post('@Url.Action("DeleteTKB")', { id: id }, function (res) {
            console.log(res);

            if (!res.oke) {
                alert(res.msg);
                return;
            }

            alert("Xóa thành công");

            $('#modalEditTKB').modal('hide');

            reloadTKB();
        });
    })

    // ===== RELOAD TKB =====
    function reloadTKB() {
        $.get('@Url.Action("Index")', {
            NamHocID: @Model.NamHocID,
            HocKyID: @Model.HocKyID,
            tuan: @Model.Tuan,
            caHoc: '@Model.CaHoc'
        }, function (html) {

            $('.tkb-container').html(
                $(html).find('.tkb-container').html()
            );
        });
    }

    // ===== FILL SELECT =====
    function fillSelect($select, list, selectedId) {

        $select.empty();

        list.forEach(item => {
            $select.append(
                $('<option>', {
                    value: item.id,
                    text: item.text,
                    selected: item.id == selectedId
                })
            );
        });
    }

    function fillSelectAdd($select, list, placeholder) {

        $select.empty();

        // ✅ option mặc định
        $select.append(
            $('<option>', {
                value: '',
                text: placeholder
            })
        );

        list.forEach(item => {
            $select.append(
                $('<option>', {
                    value: item.id,
                    text: item.text
                })
            );
        });
    }



        $(document).on('click', '.btn-add-tkb', function (e) {

        e.stopPropagation();

        console.log("CLICK ADD OK");

        let thu = $(this).data('thu');
        let tiet = $(this).data('tiet');
        let tuan = $(this).data('tuan');

        $('#addThu').val(thu);
        $('#addTiet').val(tiet);
        $('#addTuan').val(tuan);

        $('#addInfo').text(
            'Tuần ' + tuan + ' - Thứ ' + thu + ' - Tiết ' + tiet
        );

        // 👉 mở modal NGAY
        $('#modalAddTKB').modal('show');

        // 👉 load dữ liệu sau
        $.get('@Url.Action("addGetData")', {
            namHocId: @Model.NamHocID,
            hocKyId: @Model.HocKyID,
            thu: thu,
            tuan: tuan,
            tiet: tiet
        }, function (res) {
            fillSelectAdd($('#addLop'), res.lopHoc, '-- Vui lòng chọn lớp --');
            fillSelectAdd($('#addMon'), res.monHoc, '-- Vui lòng chọn môn học --');
            fillSelectAdd($('#addGV'), res.giaoVien, '-- Vui lòng chọn giáo viên --');
            fillSelectAdd($('#addPhong'), res.phongHoc, '-- Vui lòng chọn phòng học --');


        });

        });

    function resetAddModal() {
        $('#addLop').empty();
        $('#addMon').empty();
        $('#addGV').empty();
        $('#addPhong').empty();
    }

    $(document).on('change', '#addMon', function () {

        let monId = $(this).val();

        $.get('@Url.Action("GetGVByMon")', {
            monHocId: monId
        }, function (res) {

            fillSelect($('#addGV'), res, null);

        });

    });



// ===== CLICK THÊM =====
    $(document).on('click', '#btnAddTKB', function () {

        let data = {

Thu: $('#addThu').val(),
            TietHoc: $('#addTiet').val(),
            Tuan: $('#addTuan').val(),

            LopHocId: $('#addLop').val(),
            MonHocId: $('#addMon').val(),
            GiaoVienId: $('#addGV').val(),
            PhongHocID: $('#addPhong').val(),

            NamHocID: @Model.NamHocID,
            HocKyID: @Model.HocKyID

        };
        console.log(data);
        $.post('@Url.Action("addTKB")', data, function (res) {

            if (!res.oke) {
                alert(res.msg);
                return;
            }

            alert("Thêm thành công");

            $('#modalAddTKB').modal('hide');

            reloadTKB();
        });

    });

    $('#modalAddTKB').on('hidden.bs.modal', function () {
        $('#addLop, #addMon, #addGV, #addPhong').val('');
    });
    $('#modalAddTKB').on('hidden.bs.modal', function () {
        resetAddModal();
    });

   $('#btnSaveNgayBatDauHoc').click(function () {

    let ngay = $('#txtNgayBatDauHoc').val();
    if (!ngay) {
        alert("Vui lòng chọn ngày bắt đầu học");
        return;
    }

    $.post('@Url.Action("SetNgayBatDauHoc")', {
        namHocId: @Model.NamHocID,
        hocKyId: @Model.HocKyID,
        ngayBatDauHoc: ngay
    }, function (res) {

        if (!res.oke) {
            alert(res.msg);
            return;
        }

        // format yyyy-MM-dd -> dd/MM/yyyy
        let p = ngay.split('-');
        let ngayHienThi = p[2] + '/' + p[1] + '/' + p[0];

        //  cập nhật ngay – KHÔNG reload
        $('#lblNgayBatDauHoc')
            .text(ngayHienThi)
            .removeClass('text-danger')
            .addClass('text-primary');

        alert(res.msg);

        //  đóng modal
        $('#modalSetNgayBatDauHoc').modal('hide');
    });
   });

