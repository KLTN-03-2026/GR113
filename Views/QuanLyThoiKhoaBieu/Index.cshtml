    // ===== RELOAD TKB =====
    function reloadTKB() {
        $.get('@Url.Action("Index")', {
            NamHocID: @Model.NamHocID,
            HocKyID: @Model.HocKyID,
            tuan: @Model.Tuan,
            caHoc: '@Model.CaHoc'
        }, function (html) {

            $('.tkb-container').html(
                $(html).find('.tkb-container').html()
            );
        });
    }

    // ===== FILL SELECT =====
    function fillSelect($select, list, selectedId) {

        $select.empty();

        list.forEach(item => {
            $select.append(
                $('<option>', {
                    value: item.id,
                    text: item.text,
                    selected: item.id == selectedId
                })
            );
        });
    }

    function fillSelectAdd($select, list, placeholder) {

        $select.empty();

        // ✅ option mặc định
        $select.append(
            $('<option>', {
                value: '',
                text: placeholder
            })
        );

        list.forEach(item => {
            $select.append(
                $('<option>', {
                    value: item.id,
                    text: item.text
                })
            );
        });
    }



        $(document).on('click', '.btn-add-tkb', function (e) {

