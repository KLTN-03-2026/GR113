@if (Model.ThoiKhoaBieus != null && Model.ThoiKhoaBieus.Any())
{
    <hr />

    <!-- HEADER TUẦN -->
    <div class="alert alert-danger fw-bold">
        📅 Lịch học Tuần @Model.Tuan
    </div>

    <!-- NÚT CA + NÚT NEXT -->
    <div class="d-flex justify-content-between mb-3">
        <div>
            <button class="btn btn-primary me-2"
                    onclick="doiCa('Sang')">
                ☀️ Ca sáng
            </button>

            <button class="btn btn-warning"
                    onclick="doiCa('Chieu')">
                🌙 Ca chiều
            </button>

        </div>

        <div>
            <button class="btn btn-secondary"
                    onclick="nextWeek()">
                Tuần tiếp theo ➡
            </button>
        </div>
    </div>

    <div class="tkb-container">
        <!-- BẢNG TKB -->

        <table class="table table-bordered text-center align-middle">
            <thead>
                <tr>
                    <th rowspan="2"></th>


                    @for (int thu = 2; thu <= 8; thu++)
                    {
                        <th>Thứ @(thu == 8 ? "CN" : thu.ToString())</th>
                    }
                </tr>
                <tr>
                    @for (int i = 0; i < 7; i++)
                    {
                        <th>dd/MM/yyyy</th>
                    }
                </tr>
            </thead>

            <tbody>
                @for (int tiet = 1; tiet <= 10; tiet++)
                {

                    if (tiet == 6)
                    {
                        <tr class="row-ca-chuyen">
                            <td colspan="8">
                                🌙 Buổi chiều (Tiết 6 → 10)
                            </td>
                        </tr>
                    }

                    <tr>
                        <td><b>Tiết @tiet</b></td>

                        @for (int thu = 2; thu <= 8; thu++)
                        {
                            //var list = Model.ThoiKhoaBieus
                            //    .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            //    .ToList();
                            //var list = Model.ThoiKhoaBieus
                            //    .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            //.Where(x =>
                            //    (!Model.SelectedLopHocID.HasValue || x.LopHocID == Model.SelectedLopHocID) &&
                            //    (!Model.SelectedGiaoVienID.HasValue || x.GiaoVienID == Model.SelectedGiaoVienID)
                            //    ).ToList();
                            var list = Model.ThoiKhoaBieus
                                    .Where(x => x.Thu == thu && x.TietHoc == tiet)
                                    .ToList();

                            <td class="text-start position-relative">
                                <!--Dau cong them tiet-->
                                <div class="tkb-add btn-add-tkb"
                                     data-thu="@thu"
                                     data-tiet="@tiet"
                                     data-tuan="@Model.Tuan">
                                    <i class="fa fa-plus"></i>
                                </div>

                                @{
                                    bool laSang = Model.CaHoc == "Sang";

                                    bool isChaoCo =
                                        thu == 2 &&
                                        ((laSang && tiet == 1) || (!laSang && tiet == 10));

                                    bool isSinhHoat =
                                        thu == 7 &&
                                        ((laSang && tiet == 5) || (!laSang && tiet == 10));
                                }


                                @if (isChaoCo || isSinhHoat)
                                {
                                    <div class="tkb-item">

                                        @if (isChaoCo)
                                        {
                                            <div>⭐ Chào cờ</div>
                                        }
                                        @if (isSinhHoat)
                                        {
                                            <div>⭐ Sinh hoạt lớp</div>
                                        }
                                    </div>
                                }

                                else
                                {
                                    foreach (var item in list)
                                    {
                                        <div class="tkb-item tkb-click"
                                             data-id="@item.TKBID"
                                             data-lopid="@item.LopHocID"
                                             data-lopten="@item.LopHoc.TenLop"
                                             data-monid="@item.MonHocID"
                                             data-monten="@item.MonHoc.TenMonHoc"
                                             data-gvid="@item.GiaoVienID"
                                             data-gvten="@item.GiaoVien.NguoiDung.HoTen"
                                             data-phongid="@item.PhongHocID"
                                             data-phongten="@item.PhongHoc.TenPhong"
                                             data-thu="@item.Thu"
                                             data-tiet="@item.TietHoc"
                                             data-tuan="@item.Tuan">



                                            <b>@item.PhongHoc.TenPhong</b><br />
                                            Lớp: <b>@item.LopHoc.TenLop</b><br />
                                            Môn học: @item.MonHoc.TenMonHoc<br />
                                            GV: @item.GiaoVien.NguoiDung.HoTen
                                        </div>

                                    }
                                }
                            </td>
                        }
                    </tr>
                }


            </tbody>
        </table>
    </div>
}


<div class="modal fade" id="modalEditTKB" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">✏Chỉnh sửa tiết học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="editTKBId" />

                <p class="text-muted" id="tkbInfo" style="font-weight:bold; font-size:20px; display:flex;justify-content:center;"></p>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label>Lớp</label>
                        <select id="editLop" class="form-control"></select>
                    </div>
                    <div class="col-md-6">
                        <label>Môn học</label>
                        <select id="editMon" class="form-control"></select>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-6">
                        <label>Giáo viên</label>
                        <select id="editGV" class="form-control"></select>
                    </div>
                    <div class="col-md-6">
                        <label>Phòng học</label>
                        <select id="editPhong" class="form-control"></select>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="btnDeleteTKB">🗑️ Xóa</button>
                <button type="button" class="btn btn-primary" id="btnSaveTKB">💾 Cập nhật</button>
                <button class="btn btn-secondary" data-bs-dismiss="modal">❌ Hủy</button>
            </div>

        </div>
    </div>
</div>
<!--them tiet hoc-->
<div class="modal fade" id="modalAddTKB">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Thêm tiết học</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="addThu" />
                <input type="hidden" id="addTiet" />
                <input type="hidden" id="addTuan" />

                <p id="addInfo" class="font-weight-bold text-center" style="font-size: 25px; font-weight:bold;"></p>

                <div class="form-group">
                    <label>🏫 Lớp</label>
                    <select id="addLop" class="form-control">
                        <option value="">-- Vui lòng chọn lớp --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>📚 Môn học</label>
                    <select id="addMon" class="form-control">
                        <option value="">-- Vui lòng chọn môn học --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>👨‍🏫 Giáo viên</label>
                    <select id="addGV" class="form-control">
                        <option value="">-- Vui lòng chọn giáo viên --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>🚪 Phòng học</label>
                    <select id="addPhong" class="form-control">
                        <option value="">-- Vui lòng chọn phòng học--</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success" id="btnAddTKB">Thêm</button>

            </div>

        </div>
    </div>
</div>

<script>

    // ===== SIGNALR (SAFE) =====
    if (typeof $.connection !== "undefined") {
        try {
            var hub = $.connection.gaProgressHub;

            hub.client.updateProgress = function (message) {
                $("#aiText").text(message);
            };

            $.connection.hub.start();

        } catch (e) {
            console.warn("SignalR error:", e);
        }
    }

    // ===== SUBMIT =====
    function onSubmitTKB() {
        $("#btnSubmit").prop("disabled", true);
        $("#aiOverlay").css("display", "flex");
        $("#aiText").text("AI đang khởi tạo...");
        return true;
    }

    // ===== CHUYỂN CA =====
    function doiCa(ca) {
        window.location.href =
            '@Url.Action("Index")'
            + '?NamHocID=@Model.NamHocID'
            + '&HocKyID=@Model.HocKyID'
            + '&tuan=@Model.Tuan'
            + '&caHoc=' + ca;
    }

    // ===== TUẦN TIẾP =====
    function nextWeek() {
        window.location.href =
            '@Url.Action("Index")'
            + '?NamHocID=@Model.NamHocID'
            + '&HocKyID=@Model.HocKyID'
            + '&tuan=' + (@Model.Tuan + 1)
            + '&caHoc=@Model.CaHoc';
    }

    // ===== CLICK Ô TKB =====
       $(document).ready(function () {

            $(document).on('click', '.tkb-click', function () {

                console.log("CLICK OK");

                let t = $(this);

                $('#editTKBId').val(t.data('id'));

                $('#tkbInfo').text(
                    'Tuần ' + t.data('tuan') +
                    ' - Thứ ' + t.data('thu') +
                    ' - Tiết ' + t.data('tiet')
                );

                $.get('@Url.Action("GetEditData")', {
                    namHocId: @Model.NamHocID,
                    hocKyId: @Model.HocKyID,
                    lopHocId: t.data('lopid'),
                     monHocId: t.data('monid')
                }, function (res) {

                    fillSelect($('#editLop'), res.lops, t.data('lopid'));
                    fillSelect($('#editMon'), res.mons, t.data('monid'));
                    fillSelect($('#editGV'), res.gvs, t.data('gvid'));
                    fillSelect($('#editPhong'), res.phongs, t.data('phongid'));

                    // ✅ Bootstrap 4
                    $('#modalEditTKB').modal('show');
                });
            });

       });

    $('#editMon').change(function () {

        let monId = $(this).val();

        $.get('@Url.Action("GetEditData")', {
            namHocId: @Model.NamHocID,
            hocKyId: @Model.HocKyID,
            lopHocId: $('#editLop').val(),
            monHocId: monId
        }, function (res) {

            // chỉ update giáo viên thôi
            fillSelect($('#editGV'), res.gvs, null);
        });
    });

    // ===== SAVE =====
       $(document).on('click', '#btnSaveTKB', function () {

        console.log("CLICK SAVE");

        let data = {
            TKBID: $('#editTKBId').val(),
            LopHocId: $('#editLop').val(),
            GiaoVienId: $('#editGV').val(),
            MonHocId: $('#editMon').val(),
            PhongHocID: $('#editPhong').val()
        };

        $.post('@Url.Action("UpdateTKB")', data, function (res) {

            console.log(res);

            if (!res.oke) {
                alert(res.msg);
                return;
            }

            alert("Cập nhật thành công");

            $('#modalEditTKB').modal('hide'); // ✅ đúng bootstrap 4

            reloadTKB();
        });
    });

    // ===== DELETE =====
    $(document).on('click', '#btnDeleteTKB', function () {
        let id = $('#editTKBId').val();

        if (!id) {
            alert("Không có tiết để xóa");
            return
        }

        if (!confirm("Bạn Chắc chắn muốn xóa tiết này không.")) return;

        $.post('@Url.Action("DeleteTKB")', { id: id }, function (res) {
            console.log(res);

            if (!res.oke) {
                alert(res.msg);
                return;
            }

            alert("Xóa thành công");

            $('#modalEditTKB').modal('hide');

            reloadTKB();
        });
    })

    // ===== RELOAD TKB =====
    function reloadTKB() {
        $.get('@Url.Action("Index")', {
            NamHocID: @Model.NamHocID,
            HocKyID: @Model.HocKyID,
            tuan: @Model.Tuan,
            caHoc: '@Model.CaHoc'
        }, function (html) {

            $('.tkb-container').html(
                $(html).find('.tkb-container').html()
            );
        });
    }

    // ===== FILL SELECT =====
    function fillSelect($select, list, selectedId) {

        $select.empty();

        list.forEach(item => {
            $select.append(
                $('<option>', {
                    value: item.id,
                    text: item.text,
                    selected: item.id == selectedId
                })
            );
        });
    }

    function fillSelectAdd($select, list, placeholder) {

        $select.empty();

        // ✅ option mặc định
        $select.append(
            $('<option>', {
                value: '',
                text: placeholder
            })
        );

        list.forEach(item => {
            $select.append(
                $('<option>', {
                    value: item.id,
                    text: item.text
                })
            );
        });
    }


    // ===== CLICK NÚT + (MỞ MODAL THÊM) =====
    @*$(document).on('click', '.btn-add-tkb', function (e) {

        e.stopPropagation();

        let thu = $(this).data('thu');
        let tiet = $(this).data('tiet');
