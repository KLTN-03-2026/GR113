<script>

    // ===== SIGNALR (SAFE) =====
    if (typeof $.connection !== "undefined") {
        try {
            var hub = $.connection.gaProgressHub;

            //hub.client.updateProgress = function (message) {
            //    $("#aiText").text(message);
            //};
            //hub.client.updateProgress = function (message) {

            //    //$("#aiText").text(message);
            //    $("#aiText").text(message);

            //    $('#aiLog').prepend(`
            //        <div style="margin-bottom:6px;">
            //            > ${message}
            //        </div>
            //    `);

            //    // ✅ Khi AI chạy xong
            //    if (message.includes("Hoàn tất")) {

            //        setTimeout(function () {

            //            //  ẩn overlay
            //            $("#aiOverlay").hide();

            //            //  load lại trang để hiển thị TKB mới
            //            location.reload();

            //        }, 1500); // delay 1.5s cho đẹp
