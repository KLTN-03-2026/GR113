@using (Html.BeginForm(
    "TaoThoiKhoaBieu",
    "QuanLyThoiKhoaBieu",
    FormMethod.Post,
    new { id = "formTKB", onsubmit = "return onSubmitTKB();" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-4">
            <label>Năm học</label>
            @Html.DropDownListFor(
                m => m.NamHocID,
                Model.ListNamHoc,
                "-- Chọn năm học --",
                new { @class = "form-control", required = "required" })
        </div>

        <div class="col-md-4">
            <label>Học kỳ</label>
            @Html.DropDownListFor(
                m => m.HocKyID,
                Model.ListHocKy,
                "-- Chọn học kỳ --",
                new { @class = "form-control", required = "required" })
        </div>

        <div class="col-md-4" style="margin-top:25px;">
            <button type="submit" id="btnSubmit" class="btn btn-success">
                🚀 Tạo thời khóa biểu
            </button>
        </div>
    </div>
}

