<style>
    /*hover chitiet tkb*/
    .tkb-item {
        border: 1px solid #ddd;
        border-left: 4px solid #007bff;
        padding: 6px;
        margin-bottom: 6px;
        background: #f9f9f9;
        transition: all 0.25s ease;
        cursor: pointer;
    }


        .tkb-item:hover {
            background: linear-gradient(135deg, #e3f2fd, #ffffff);
            box-shadow: 0 8px 20px rgba(0,0,0,0.18);
            border-left-color: #ff9800;
            transform: translateY(-2px) scale(1.00);
            border-left-color: #1e88e5;
        }


    /* Hàng phân cách ca sáng - chiều */
    .row-ca-chuyen {
        background: #9e0d20;
        color: #e65100;
        font-weight: bold;
        text-align: center;
        letter-spacing: 1px;
    }

        .row-ca-chuyen td {
            padding: 8px;
            border-top: 2px solid #ff9800;
            border-bottom: 2px solid #ff9800;
        }

    /* Nút Xem toàn trường */
    .btn-view-all {
        height: 38px;
        width: 30px; /* ✔ bằng dropdown */
        background: #f5f7fa; /* ✔ xám rất nhạt */
        color: #2e3a59;
        font-weight: 600;
        border: 1px solid #ced4da;
        border-radius: 6px;
        transition: all 0.25s ease;
        margin-top: 23px;
    }

        /* Hover */
        .btn-view-all:hover {
            background: #e3f2fd; /* xanh nhạt */
            border-color: #1e88e5;
            color: #1e88e5;
        }

        /* Khi đang xem toàn trường (tuỳ chọn) */
        .btn-view-all.active {
            background: #1e88e5;
            color: #fff;
            border-color: #1e88e5;
        }

    /*dau cong them TKB*/
    .tkb-add {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 22px;
        height: 22px;
        background: #1e88e5;
        color: white;
        border-radius: 50%;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0.8;
        transition: 0.2s;
        z-index: 10;
    }

    .tkb-add {
        z-index: 9999;
        pointer-events: auto;
    }

    .tkb-add {
        opacity: 0;
    }

    td:hover .tkb-add {
        opacity: 1;
    }
    /* ===== MODAL ADD TKB ===== */
    #modalAddTKB .modal-content {
        border-radius: 12px;
        overflow: hidden;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    #modalAddTKB .modal-header {
        background: linear-gradient(135deg, #1e88e5, #42a5f5);
        color: white;
        border-bottom: none;
    }

    #modalAddTKB .modal-title {
        font-weight: 600;
        font-size: 18px;
    }

    #modalAddTKB .modal-body {
        padding: 20px;
    }

    #modalAddTKB label {
        font-weight: 600;
        color: #333;
    }

    #modalAddTKB select {
        border-radius: 8px;
        height: 38px;
    }

    #modalAddTKB .modal-dialog {
        margin-top: 110px; /* chỉnh 80–150px tùy mắt */
    }

    #modalAddTKB .modal-footer {
        border-top: none;
        padding: 15px 20px;
    }

    /* Nút */
    #modalAddTKB .btn-success {
        border-radius: 8px;
        padding: 6px 18px;
        font-weight: 600;
    }

    #modalAddTKB .btn-secondary {
        border-radius: 8px;
    }

    /* Info */
    #addInfo {
        font-size: 16px;
        color: #1e88e5;
        margin-bottom: 15px;
    }

    .modal.fade .modal-dialog {
        transform: translateY(-20px);
        transition: all 0.3s ease;
    }

    .modal.show .modal-dialog {
        transform: translateY(0);
    }

    /*huy*/

</style>

<h2>Quản lý thời khóa biểu</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@using (Html.BeginForm(
    "TaoThoiKhoaBieu",
    "QuanLyThoiKhoaBieu",
    FormMethod.Post,
    new { onsubmit = "return onSubmitTKB();" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-4">
            <label>Năm học</label>
            @Html.DropDownListFor(
                m => m.NamHocID,
                Model.ListNamHoc,
                "-- Chọn năm học --",
                new { @class = "form-control", required = "required" })
        </div>

        <div class="col-md-4">
            <label>Học kỳ</label>
            @Html.DropDownListFor(
                m => m.HocKyID,
                Model.ListHocKy,
                "-- Chọn học kỳ --",
                new { @class = "form-control", required = "required" })
        </div>

        <div class="col-md-4" style="margin-top:25px;">
            <button type="submit" id="btnSubmit" class="btn btn-success">
                🚀 Tạo thời khóa biểu
            </button>
        </div>
    </div>
}

<!-- AI OVERLAY -->
<div id="aiOverlay" style="display:none">
    <div class="ai-box">
        <div class="ai-spinner"></div>
        <h3>🤖 AI đang xếp thời khóa biểu</h3>
        <p id="aiText">Đang khởi tạo...</p>
    </div>
</div>

