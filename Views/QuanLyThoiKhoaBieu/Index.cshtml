<script>
   function themNamHoc() {
    var tenNamHoc = $("#tenNamHoc").val().trim();
    var trangThai = $("#trangThaiNamHoc").val();

    // ✅ VALIDATE
    if (tenNamHoc === "") {
        showToast("Tên năm học không được để trống", "error");
        return;
    }

    // regex đúng format 2024-2025
    var regex = /^\d{4}-\d{4}$/;
    if (!regex.test(tenNamHoc)) {
        showToast("Năm học phải dạng 2024-2025", "error");
        return;
    }

    // check logic năm
    var parts = tenNamHoc.split("-");
    if (parseInt(parts[1]) !== parseInt(parts[0]) + 1) {
        showToast("Năm sau phải bằng năm trước + 1", "error");
        return;
    }

    // ✅ disable nút tránh spam click
    $(".btn-success").prop("disabled", true);

    $.ajax({
        url: '@Url.Action("ThemNamHoc", "QuanLyThoiKhoaBieu")',
        type: 'POST',
        data: {
            tenNamHoc: tenNamHoc,
            trangThai: trangThai
        },
        success: function (res) {

            if (res.success) {
                showToast(res.message, "success");

                // đóng modal
                $("#modalNamHoc").modal("hide");

                // clear input
                $("#tenNamHoc").val("");

                // reload
                setTimeout(() => {
                    location.reload();
                }, 800);
            }
            else {
                showToast(res.message, "error");
            }

            // enable lại nút
            $(".btn-success").prop("disabled", false);
        },
        error: function () {
            showToast("Lỗi server!", "error");
            $(".btn-success").prop("disabled", false);
        }
    });
}
    $("#tenNamHoc").on("input", function () {
        let value = $(this).val();

        // chỉ cho số và dấu -
        value = value.replace(/[^0-9\-]/g, "");

        // đảm bảo chỉ có 1 dấu -
        let parts = value.split("-");
        if (parts.length > 2) {
            value = parts[0] + "-" + parts[1];
        }

        $(this).val(value);
    });
    $("#soTuan").on("input", function () {
        if ($(this).val() < 1) {
            $(this).val(1);
        }
    });

    //Hoc ky
    function themHocKy() {

    var tenHocKy = $("#tenHocKy").val();
    var namHocID = $("#namHocHocKy").val();
    var soTuan = $("#soTuan").val();

    // ✅ validate học kỳ
    if (!tenHocKy) {
        showToast("Vui lòng chọn học kỳ", "error");
        return;
    }

    // ✅ validate năm học
    if (!namHocID) {
        showToast("Vui lòng chọn năm học", "error");
        return;
    }

    // ✅ validate số tuần
    if (!soTuan || soTuan <= 0) {
        showToast("Số tuần phải lớn hơn 0", "error");
        return;
    }

    $.ajax({
        url: '@Url.Action("ThemHocKy", "QuanLyThoiKhoaBieu")',
        type: 'POST',
        data: {
            tenHocKy: tenHocKy,
            namHocID: namHocID,
            soTuan: soTuan
        },
        success: function (res) {

            if (res.success) {
                showToast(res.message, "success");

                // đóng modal
                $("#modalHocKy").modal("hide");

                // reset form
                $("#tenHocKy").val("");
                $("#namHocHocKy").val("");
                $("#soTuan").val("");

                // reload
                setTimeout(() => {
                    location.reload();
                }, 800);
            }
            else {
                showToast(res.message, "error");
            }
        },
        error: function () {
            showToast("Lỗi server!", "error");
        }
    });
}


    // ===== SIGNALR (SAFE) =====
    if (typeof $.connection !== "undefined") {
        try {
            var hub = $.connection.gaProgressHub;


            hub.client.updateProgress = function (message) {

                // text status
                $("#aiText").text(message);

                // log terminal
                $('#aiLog').prepend(`
        <div style="margin-bottom:6px;">
            > ${message}
        </div>
    `);

                // ===== AI HOÀN TẤT =====
                if (message.includes("Hoàn tất")) {

                    // text đẹp
                    $("#aiText").text("✅ chờ trong giây lát nhé");

                    // progress full
                    $(".ai-progress-bar").css({
                        width: "100%",
                        transition: "1s ease"
                    });

                    // terminal đẹp hơn
                    $('#aiLog').prepend(`
            <div style="color:#00ffcc;">
                > Completed successfully ✅
            </div>
        `);

                    // delay cho user thấy hoàn tất
                    setTimeout(function () {
                        location.reload();
                    }, 400);
                }
            };

            $.connection.hub.start();

        } catch (e) {
            console.warn("SignalR error:", e);
        }
    }


    let isSubmittingTKB = false;

    function onSubmitTKB() {

        // ✅ submit thật -> cho chạy luôn
        if (isSubmittingTKB) {
            return true;
        }

        Swal.fire({
            title: 'Tạo thời khóa biểu?',
            html: `
            <div style="font-size:15px;color:#555">
                AI sẽ tự động xếp thời khóa biểu cho toàn trường.<br>
                Quá trình này có thể mất vài phút.
            </div>
        `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '🚀 Bắt đầu tạo',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#d33',
            reverseButtons: true,
            allowOutsideClick: false
        }).then((result) => {

            if (result.isConfirmed) {

                //  đánh dấu đang submit thật
                isSubmittingTKB = true;

                // disable nút
                $("#btnSubmit").prop("disabled", true);

                // overlay AI như code cũ
                $("#aiOverlay").css("display", "flex");

                $("#aiText").text("🤖 AI đang khởi tạo...");

                // submit thật
                $("#formTKB")[0].submit();
            }
        });

        return false;
    }

