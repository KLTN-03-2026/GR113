<div class="modal fade" id="modalNghiHoc">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">📛 Nghỉ học</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">

                <!-- ✅ SWITCH -->
                <div class="form-group">
                    <label>Chọn loại nghỉ</label>
                    <select id="loaiNghi" class="form-control">
                        <option value="ngay">Nghỉ theo ngày</option>
                        <option value="tiet">Nghỉ theo tiết</option>
                    </select>
                </div>

                <!-- ✅ NGHỈ THEO NGÀY -->
                <div id="boxNgay">
                    <label>📅 Ngày nghỉ</label>
                    <input type="text" id="txtNgayNghi"
                           class="form-control"
                           placeholder="Chọn nhiều ngày...">
                </div>

                <!-- ✅ NGHỈ THEO TIẾT -->
                <div id="boxTiet" style="display:none;">

                    <!-- ✅ CHỌN NGÀY -->
                    <label>📅 Chọn ngày</label>
                    <input type="date" id="ngayNghiTiet" class="form-control mb-2">

                    <!-- ✅ CHỌN TIẾT -->
                    <label>⏰ Chọn tiết nghỉ</label>

                    <div class="row">
                        @for (int i = 1; i <= 10; i++)
                        {
                            <div class="col-3 mb-2">
                                <label>
                                    <input type="checkbox" class="chkTiet" value="@i">
                                    Tiết @i
                                </label>
                            </div>
                        }
                    </div>
                </div>


            </div>

            <div class="modal-footer">
                <button class="btn btn-danger" id="btnXacNhanNghi">
                    ✅ Nghỉ học
                </button>
            </div>

        </div>
    </div>
</div>

@if (Model.ThoiKhoaBieus != null)
{
    <hr />
    <!-- HEADER TUẦN -->
    <div class="alert alert-danger fw-bold">
        📅 Lịch học Tuần @Model.Tuan
    </div>

    <!-- NÚT CA + NÚT NEXT -->
    <div class="d-flex justify-content-between mb-3">
        <div>
            <button class="btn btn-primary me-2"
                    onclick="doiCa('Sang')">
                ☀️ Ca sáng
            </button>

            <button class="btn btn-warning"
                    onclick="doiCa('Chieu')">
                🌙 Ca chiều
            </button>

            <button class="btn btn-outline-danger"
                    data-toggle="modal"
                    data-target="#modalNghiHoc">
                📛 Nghỉ học
            </button>

        </div>

        <div>

            <button class="btn btn-secondary me-2"
                    onclick="prevWeek()">
                ⬅ Tuần trước
            </button>

            <button class="btn btn-secondary"
                    onclick="nextWeek()">
                Tuần tiếp theo ➡
            </button>
        </div>
    </div>

    <div class="tkb-container">
        <!-- BẢNG TKB -->

        <table class="table table-bordered text-center align-middle">
            <thead>
                <tr>
                    <th rowspan="2"></th>


                    @for (int thu = 2; thu <= 8; thu++)
                    {

                        <th>Thứ @(thu == 8 ? "CN" : thu.ToString())</th>
                    }
                </tr>

                <tr>
                    @{
                        if (Model.NgayBatDauHoc.HasValue)
                        {
                            DateTime start = Model.NgayBatDauHoc.Value;

                            // ✅ TÍNH THỨ 2 THEO ISO (QUỐC TẾ)
                            int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                            DateTime mondayOfWeek = start.AddDays(-diff);

                            // ✅ CỘNG TUẦN (nếu xem tuần > 1)
                            mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                            for (int i = 0; i < 7; i++)
                            {
                                @*<th>@mondayOfWeek.AddDays(i).ToString("dd/MM/yyyy")</th>*@

                                DateTime today = DateTime.Now.Date;
                                DateTime day = mondayOfWeek.AddDays(i).Date;


                                <th class="@(day == today ? "today-col" : "")">
                                    @day.ToString("dd/MM/yyyy")
                                </th>
                            }
                        }
                        else
                        {
                            for (int i = 0; i < 7; i++)
                            {
                                <th>--/--/----</th>
                            }
                        }
                    }
                </tr>

            </thead>

            <tbody>
                @for (int tiet = 1; tiet <= 10; tiet++)
                {

                    if (tiet == 6)
                    {
                        <tr class="row-ca-chuyen">
                            <td colspan="8">
                                🌙 Buổi chiều (Tiết 6 → 10)
                            </td>
                        </tr>
                    }

                    <tr>
                        <td><b>Tiết @tiet</b></td>

                        @for (int thu = 2; thu <= 8; thu++)
                        {


                            DateTime today = DateTime.Now.Date;

                            DateTime start = Model.NgayBatDauHoc.Value;

                            int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                            DateTime mondayOfWeek = start.AddDays(-diff);

                            mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                            int index = thu - 2;
                            DateTime day = mondayOfWeek.AddDays(index).Date;

                            //var list = Model.ThoiKhoaBieus
                            //        .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            //        .ToList();

                            var list = Model.ThoiKhoaBieus
                            .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            .ToList();
                            //theem moi----------------------------------------

                            //bool laNgayNghi = Model.DsNgayNghi != null
                            //                && Model.DsNgayNghi.Any(n => n.Thu == thu);
                            //--------------------------------------------
                            bool laNgayNghi = Model.DsNgayNghi != null
                                && Model.DsNgayNghi.Any(n =>
                                        n.Thu == thu &&
                                        n.Tuan == Model.Tuan &&
                                        n.TietHoc == null   //  CHỈ nghỉ ngày thật
                                );
                            bool laTietNghi = Model.DsNgayNghi != null
                                && Model.DsNgayNghi.Any(n =>
                                    n.Thu == thu &&
                                    n.Tuan == Model.Tuan &&
                                    n.TietHoc == tiet   //  nghỉ đúng tiết
                                );

                            //--------------------------------------------------------------------------------------
                            bool laSang = Model.CaHoc == "Sang";

                            bool isChaoCo =
                                thu == 2 &&
                                ((laSang && tiet == 1) || (!laSang && tiet == 10));

                            bool isSinhHoat =
                                thu == 7 &&
                                ((laSang && tiet == 5) || (!laSang && tiet == 10));


                            //<td class="text-start position-relative">
                            <td class="text-start position-relative @(day == today ? "today-col" : "")">

                                @{

                                    var hocBu = Model.DsHocBu?
                                        .FirstOrDefault(x =>
                                        {
                                            var ngayHocBu = Model.DsNgayHoc
                                        .FirstOrDefault(n => n.NgayHocID == x.NgayHocBuID);

                                            var ngayNghi = Model.DsNgayHoc
                                        .FirstOrDefault(n => n.NgayHocID == x.NgayNghiID);

                                            if (ngayHocBu == null || ngayNghi == null)
                                                return false;


                                            if (ngayNghi.TietHoc != null)
                                            {
                                                return ngayHocBu.Tuan == Model.Tuan
                                        && ngayHocBu.Thu == thu
                                        && ngayHocBu.TietHoc == tiet;
                                            }

                                            // ✅ NGHỈ NGÀY
                                            return ngayHocBu.Tuan == Model.Tuan
                                        && ngayHocBu.Thu == thu;
                                        });

                                }
                                @if (laTietNghi)
                                {
                                    <div class="tkb-nghi tkb-bo-nghi"
                                         data-thu="@thu"
                                         data-tuan="@Model.Tuan"
                                         data-tiet="@tiet"
                                         title="Click để bỏ nghỉ tiết">
                                        🚫 NGHỈ HỌC (bỏ nghỉ)
                                    </div>
                                }
                                else if (laNgayNghi)
                                {
                                    <div class="tkb-nghi tkb-bo-nghi"
                                         data-thu="@thu"
                                         data-tuan="@Model.Tuan"
                                         title="Click để mở lại ngày học">
                                        🚫 NGHỈ HỌC (bỏ nghỉ)
                                    </div>
                                }

                                // ✅ HỌC BÙ
                                else if (hocBu != null)
                                {
                                    var ngayHocBu = Model.DsNgayHoc
                                        .FirstOrDefault(n => n.NgayHocID == hocBu.NgayHocBuID);

                                    var ngayNghi = Model.DsNgayHoc
                                        .FirstOrDefault(n => n.NgayHocID == hocBu.NgayNghiID);

                                    if (ngayHocBu != null && ngayNghi != null)
                                    {
                                        var listHocBu = new List<demomvc.Models.ThoiKhoaBieu>();

                                        using (var db2 = new demomvc.Models.QuanLyTruongHocEntities2())
                                        {
                                            listHocBu = db2.ThoiKhoaBieu
                                                .Include("PhongHoc")
                                                .Include("LopHoc")
                                                .Include("MonHoc")
                                                .Include("GiaoVien.NguoiDung")
                                                .Where(x =>
                                                    x.NamHocID == Model.NamHocID &&
                                                    x.HocKyID == Model.HocKyID &&
                                                    x.Tuan == ngayNghi.Tuan &&
                                                    x.Thu == ngayNghi.Thu &&

                                                    (
                                                    // ✅ nghỉ tiết
                                                    (ngayNghi.TietHoc != null && x.TietHoc == ngayNghi.TietHoc)

                                                    ||

                                                    // ✅ nghỉ ngày → map theo tiết hiện tại
                                                    (ngayNghi.TietHoc == null && x.TietHoc == tiet)
                                                    )
                                                    &&
                                                    (
                                                    (Model.CaHoc == "Sang" && x.LopHoc.CaHoc == "SANG") ||
                                                    (Model.CaHoc == "Chieu" && x.LopHoc.CaHoc == "CHIEU")
                                                    )
                                                   )

                                                .ToList();
                                        }

                                        <div class="tkb-add btn-add-tkb"
                                             data-thu="@thu"
                                             data-tiet="@tiet"
                                             data-tuan="@Model.Tuan">
                                            <i class="fa fa-plus"></i>
                                            <span class="tkb-tooltip">Thêm tiết học</span>
                                        </div>

                                        // ✅ CHỈ HIỂN THỊ HỌC BÙ
                                        foreach (var item in listHocBu)
                                        {
                                            <div class="tkb-item tkb-click"
                                                 data-id="@item.TKBID"
                                                 data-lopid="@item.LopHocID"
                                                 data-lopten="@item.LopHoc.TenLop"
                                                 data-monid="@item.MonHocID"
                                                 data-monten="@item.MonHoc.TenMonHoc"
                                                 data-gvid="@item.GiaoVienID"
                                                 data-gvten="@item.GiaoVien.NguoiDung.HoTen"
                                                 data-phongid="@item.PhongHocID"
                                                 data-phongten="@item.PhongHoc.TenPhong"
                                                 data-thu="@thu"
                                                 data-tiet="@tiet"
                                                 data-tuan="@Model.Tuan">

                                                <b>@item.PhongHoc.TenPhong</b><br />
                                                Lớp: <b>@item.LopHoc.TenLop</b><br />
                                                Môn học: @item.MonHoc.TenMonHoc<br />
                                                GV: @item.GiaoVien.NguoiDung.HoTen

                                                <div style="color:red;font-weight:bold;">
                                                    🔁 HỌC BÙ
                                                </div>
                                            </div>
                                        }
                                    }
                                }

                                // ✅ BÌNH THƯỜNG
                                else
                                {
                                    <div class="tkb-add btn-add-tkb"
                                         data-thu="@thu"
                                         data-tiet="@tiet"
                                         data-tuan="@Model.Tuan">
                                        <i class="fa fa-plus"></i>
                                        <span class="tkb-tooltip">Thêm tiết học</span>
                                    </div>

                                    if (isChaoCo || isSinhHoat)
                                    {
                                        <div class="tkb-item">
                                            @if (isChaoCo)
                                            {
                                                <div>⭐ Chào cờ</div>
                                            }
                                            @if (isSinhHoat)
                                            {
                                                <div>⭐ Sinh hoạt lớp</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        foreach (var item in list)
                                        {
                                            <div class="tkb-item tkb-click"
                                                 data-id="@item.TKBID"
                                                 data-lopid="@item.LopHocID"
                                                 data-lopten="@item.LopHoc.TenLop"
                                                 data-monid="@item.MonHocID"
                                                 data-monten="@item.MonHoc.TenMonHoc"
                                                 data-gvid="@item.GiaoVienID"
                                                 data-gvten="@item.GiaoVien.NguoiDung.HoTen"
                                                 data-phongid="@item.PhongHocID"
                                                 data-phongten="@item.PhongHoc.TenPhong"
                                                 data-thu="@item.Thu"
                                                 data-tiet="@item.TietHoc"
                                                 data-tuan="@item.Tuan">

                                                <b>@item.PhongHoc.TenPhong</b><br />
                                                Lớp: <b>@item.LopHoc.TenLop</b><br />
                                                Môn học: @item.MonHoc.TenMonHoc<br />
                                                GV: @item.GiaoVien.NguoiDung.HoTen
                                            </div>
                                        }
                                    }
                                }

                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


<div class="modal fade" id="modalEditTKB" tabindex="-1">
