@model demomvc.Models.XemTKB
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Tranhchu_LayoutPage1.cshtml";
}

<script src="~/Scripts/jquery-3.7.0.js"></script>
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery-3.6.0.min.js"></script>
<script src="/signalr/hubs"></script>
<link href="~/css/quanlyTKB.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    /*hover chitiet tkb*/
    .tkb-item {
        border: 1px solid #ddd;
        border-left: 4px solid #007bff;
        padding: 6px;
        margin-bottom: 6px;
        background: #f9f9f9;
        transition: all 0.25s ease;
        cursor: pointer;
    }


        .tkb-item:hover {
            background: linear-gradient(135deg, #e3f2fd, #ffffff);
            box-shadow: 0 8px 20px rgba(0,0,0,0.18);
            border-left-color: #ff9800;
            transform: translateY(-2px) scale(1.00);
            border-left-color: #1e88e5;
        }


    /* Hàng phân cách ca sáng - chiều */
    .row-ca-chuyen {
        background: #9e0d20;
        color: #e65100;
        font-weight: bold;
        text-align: center;
        letter-spacing: 1px;
    }

        .row-ca-chuyen td {
            padding: 8px;
            border-top: 2px solid #ff9800;
            border-bottom: 2px solid #ff9800;
        }


    .bg-danger {
        background: #ef5350 !important;
        color: white;
    }

    /* ngay nghi*/
    .tkb-nghi {
        background: linear-gradient(135deg, #ff5252, #d32f2f);
        color: white;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px;
        border-radius: 10px;
        border: 1.5px solid rgba(255,255,255,0.25);
        box-shadow: inset 0 0 6px rgba(255,255,255,0.2), 0 6px 16px rgba(211,47,47,0.5);
        transition: all 0.25s ease;
    }

        .tkb-nghi:hover {
            transform: scale(1.06);
            box-shadow: 0 10px 22px rgba(211,47,47,0.7), inset 0 0 8px rgba(255,255,255,0.3);
        }

    /*full cot hom nay*/
    .today-col {
        background-color: #bbdefb !important;
        border-left: 3px solid #1e88e5 !important;
        border-right: 3px solid #1e88e5 !important;
        box-shadow: inset 0 0 10px rgba(30,136,229,0.25);
    }
</style>

<h2>Thời Khóa Biểu</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model.ThoiKhoaBieus == null || !Model.ThoiKhoaBieus.Any())
{
    <div class="alert alert-warning text-center fw-bold">
        Thời khóa biểu chưa được xếp cho tuần này
    </div>
    return;
}

@if (Model.ThoiKhoaBieus != null && Model.ThoiKhoaBieus.Any())
{
    <hr />

    <!-- HEADER TUẦN -->
    <div class="alert alert-danger fw-bold">
        📅 Lịch học Tuần @Model.Tuan
    </div>

    <!-- NÚT CA + NÚT NEXT -->
    <div class="d-flex justify-content-between mb-3">

        <div>

            <button class="btn btn-secondary me-2"
                    onclick="prevWeek()">
                ⬅
            </button>

            <button class="btn btn-secondary"
                    onclick="nextWeek()">
                Tuần tiếp theo ➡
            </button>
        </div>
    </div>

    <!-- BẢNG TKB -->
    <table class="table table-bordered text-center align-middle">
        <thead>
            <tr>
                <th rowspan="2"></th>


                @for (int thu = 2; thu <= 8; thu++)
                {
                    <th>Thứ @(thu == 8 ? "CN" : thu.ToString())</th>
                }
            </tr>


            <tr>
                @{
                    if (Model.NgayBatDauHoc.HasValue)
                    {
                        DateTime start = Model.NgayBatDauHoc.Value;

                        // ✅ TÍNH THỨ 2 THEO ISO (QUỐC TẾ)
                        int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                        DateTime mondayOfWeek = start.AddDays(-diff);

                        // ✅ CỘNG TUẦN (nếu xem tuần > 1)
                        mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                        for (int i = 0; i < 7; i++)
                        {

                            DateTime today = DateTime.Now.Date;
                            DateTime day = mondayOfWeek.AddDays(i).Date;

                            <th class="@(day == today ? "today-col" : "")">
                                @day.ToString("dd/MM/yyyy")
                            </th>

                        }
                    }
                    else
                    {
                        for (int i = 0; i < 7; i++)
                        {


                        }
                    }
                }
            </tr>
        </thead>

        <tbody>
            @for (int tiet = 1; tiet <= 10; tiet++)
            {

                if (tiet == 6)
                {
                    <tr class="row-ca-chuyen">
                        <td colspan="8">
                            🌙 Buổi chiều (Tiết 6 → 10)
                        </td>
                    </tr>
                }

                <tr>
                    <td><b>Tiết @tiet</b></td>

                    @for (int thu = 2; thu <= 8; thu++)
                    {
                        var list = Model.ThoiKhoaBieus
                            .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            .ToList();

                        bool laNgayNghi = Model.DsNgayNghi != null
                                && Model.DsNgayNghi.Any(n =>
                                    n.Tuan == Model.Tuan &&
                                    n.Thu == thu
                                );

                        bool lachieu = Model.CaHoc == "CHIEU";
                        bool laSang = Model.CaHoc == "SANG";


                        bool isChaoCo =
                             thu == 2 &&
                             ((laSang && tiet == 1) || (!laSang && tiet == 10));

                        bool isSinhHoat =
                            thu == 7 &&
                            ((laSang && tiet == 5) || (!laSang && tiet == 10));


                        //in dam ngay hien tai
                        DateTime today = DateTime.Now.Date;
                        DateTime start = Model.NgayBatDauHoc.Value;

                        int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                        DateTime mondayOfWeek = start.AddDays(-diff);
                        mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                        int index = thu - 2;
                        DateTime day = mondayOfWeek.AddDays(index).Date;

                        <td class="text-start
                                @(laNgayNghi ? "bg-danger text-white" : "")
                                @(day == today ? "today-col" : "")">
                            @{

                                var hocBu = Model.DsHocBu?
                                    .FirstOrDefault(x =>
                                    {
                                        var ngayHocBu = Model.DsNgayHoc
                                    .FirstOrDefault(n => n.NgayHocID == x.NgayHocBuID);

                                        if (ngayHocBu == null)
                                            return false;

                                        return ngayHocBu.Tuan == Model.Tuan
                                    && ngayHocBu.Thu == thu;
                                    });
                            }

                            @if (hocBu != null)
                            {
                                var ngayHocBu = Model.DsNgayHoc
                                    .FirstOrDefault(n => n.NgayHocID == hocBu.NgayHocBuID);

                                var ngayNghi = Model.DsNgayHoc
                                    .FirstOrDefault(n => n.NgayHocID == hocBu.NgayNghiID);

                                if (ngayHocBu != null && ngayNghi != null)
                                {
                                    // ✅ TKB HIỆN TẠI
                                    var listCurrent = Model.ThoiKhoaBieus
                                        .Where(x => x.Thu == thu && x.TietHoc == tiet)
                                        .ToList();

                                    // ✅ TKB HỌC BÙ (GIỐNG QLTKB)
                                    var listHocBu = new List<demomvc.Models.ThoiKhoaBieu>();

                                    using (var db2 = new demomvc.Models.QuanLyTruongHocEntities1())
                                    {
                                        listHocBu = db2.ThoiKhoaBieu
                                            .Include("PhongHoc")
                                            .Include("LopHoc")
                                            .Include("MonHoc")
                                            .Include("GiaoVien.NguoiDung")
                                            .Where(x =>

                                                x.Tuan == ngayNghi.Tuan &&   // ✅ tuần gốc
                                                x.Thu == ngayNghi.Thu &&
                                                x.TietHoc == tiet && (

                                                    x.LopHocID == Model.LopHocId
                                                    || x.GiaoVienID == Model.GiaoVienId

                                                )

                                            )
                                            .ToList();
                                    }

                                    // ✅ 1. HIỆN TKB THẬT
                                    foreach (var item in listCurrent)
                                    {
                                        <div class="tkb-item">
                                            <b>@item.PhongHoc.TenPhong</b><br />
                                            Lớp: <b>@item.LopHoc.TenLop</b><br />
                                            Môn học: @item.MonHoc.TenMonHoc<br />
                                            @if (Model.LaHocSinh)
                                            {
                                                <span>GV: @item.GiaoVien.NguoiDung.HoTen</span>
                                            }
                                        </div>
                                    }

                                    // ✅ 2. HIỆN HỌC BÙ
                                    foreach (var item in listHocBu)
                                    {
                                        <div class="tkb-item">



                                            <b>@item.PhongHoc.TenPhong</b><br />
                                            Lớp: <b>@item.LopHoc.TenLop</b><br />
                                            Môn học: @item.MonHoc.TenMonHoc<br />

                                            @if (Model.LaHocSinh)
                                            {
                                                <span>GV: @item.GiaoVien.NguoiDung.HoTen</span>
                                            }
                                        </div>
                                    }
                                }
                            }
                            else if (laNgayNghi)
                            {
                                <div class="tkb-nghi tkb-bo-nghi">
                                    <i class="fa-solid fa-ban"></i> NGHỈ
                                </div>
                            }
                            else
                            {
                                if (isChaoCo || isSinhHoat)
                                {
                                    <div class="tkb-item">

                                        @if (isChaoCo)
                                        {
                                            <div>⭐ Chào cờ</div>
                                        }
                                        @if (isSinhHoat)
                                        {
                                            <div>⭐ Sinh hoạt lớp</div>
                                        }
                                    </div>
                                }

                                else
                                {

                                    foreach (var item in list)
                                    {
                                        <div class="tkb-item">

                                            <b>@item.PhongHoc.TenPhong</b><br />
                                            Lớp: <b>@item.LopHoc.TenLop</b><br />
                                            Môn học: @item.MonHoc.TenMonHoc<br />
                                            @if (Model.LaHocSinh)
                                            {
                                                <span> GV: @item.GiaoVien.NguoiDung.HoTen</span>
                                            }

                                        </div>

                                    }
                                }
                            }
                        </td>
                    }
                </tr>
            }


        </tbody>
    </table>
}
<script>

    $.connection.hub.start();
function nextWeek() {
    window.location.href =
        '@Url.Action("Index", "XemThoiKhoaBieu")'
        + '&tuan=' + (@Model.Tuan + 1)
    }

     // ===== TUẦN TIẾP =====
 @*function nextWeek() {
     window.location.href =
         '@Url.Action("Index", "XemThoiKhoaBieu")'
         + '?NamHocID=@Model.NamHocID'
         + '&HocKyID=@Model.HocKyID'
         + '&tuan=' + (@Model.Tuan + 1)
         + '&caHoc=@Model.CaHoc';
    }*@
    function nextWeek() {
            let tuan = @Model.Tuan + 1;

            // đảm bảo không nhỏ hơn 1
            if (tuan < 1) {
                tuan = 1;
            }

            window.location.href =
                '@Url.Action("Index")'
                + '?NamHocID=@Model.NamHocID'
                + '&HocKyID=@Model.HocKyID'
                + '&tuan=' + tuan
                + '&caHoc=@Model.CaHoc';
    }
    function prevWeek() {
     window.location.href =
         '@Url.Action("Index", "XemThoiKhoaBieu")'
         + '?NamHocID=@Model.NamHocID'
         + '&HocKyID=@Model.HocKyID'
         + '&tuan=' + (@Model.Tuan - 1)
         + '&caHoc=@Model.CaHoc';
 }
</script>

