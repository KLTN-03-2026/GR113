@model demomvc.Models.XemTKB
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Tranhchu_LayoutPage1.cshtml";
}

<script src="~/Scripts/jquery-3.7.0.js"></script>
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery-3.6.0.min.js"></script>
<script src="/signalr/hubs"></script>
<link href="~/css/quanlyTKB.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    /*hover chitiet tkb*/
    .tkb-item {
        border: 1px solid #ddd;
        border-left: 4px solid #007bff;
        padding: 6px;
        margin-bottom: 6px;
        background: #f9f9f9;
        transition: all 0.25s ease;
        cursor: pointer;
    }


        .tkb-item:hover {
            background: linear-gradient(135deg, #e3f2fd, #ffffff);
            box-shadow: 0 8px 20px rgba(0,0,0,0.18);
            border-left-color: #ff9800;
            transform: translateY(-2px) scale(1.00);
            border-left-color: #1e88e5;
        }


    /* Hàng phân cách ca sáng - chiều */
    .row-ca-chuyen {
        background: #9e0d20;
        color: #e65100;
        font-weight: bold;
        text-align: center;
        letter-spacing: 1px;
    }

        .row-ca-chuyen td {
            padding: 8px;
            border-top: 2px solid #ff9800;
            border-bottom: 2px solid #ff9800;
        }


    .bg-danger {
        background: #ef5350 !important;
        color: white;
    }

    /* ngay nghi*/
    .tkb-nghi {
        background: linear-gradient(135deg, #ff5252, #d32f2f);
        color: white;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px;
        border-radius: 10px;
        border: 1.5px solid rgba(255,255,255,0.25);
        box-shadow: inset 0 0 6px rgba(255,255,255,0.2), 0 6px 16px rgba(211,47,47,0.5);
        transition: all 0.25s ease;
    }

        .tkb-nghi:hover {
            transform: scale(1.06);
            box-shadow: 0 10px 22px rgba(211,47,47,0.7), inset 0 0 8px rgba(255,255,255,0.3);
        }

    /*full cot hom nay*/
    .today-col {
        background-color: #bbdefb !important;
        border-left: 3px solid #1e88e5 !important;
        border-right: 3px solid #1e88e5 !important;
        box-shadow: inset 0 0 10px rgba(30,136,229,0.25);
    }

    .title-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 18px 0 22px;
        margin-bottom: 20px;
        /* nền nhẹ */
        background: linear-gradient(135deg, #e3f2fd, #ffffff);
        /* viền + bo */
        border-radius: 14px;
        border: 1px solid #e0e0e0;
        /* đổ bóng nhẹ */
        box-shadow: 0 6px 18px rgba(30, 136, 229, 0.12);
    }

        /* tiêu đề bên trong */
        .title-wrapper h2 {
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: #1e88e5;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
    /* ========================= */
    /* ✅ FIX TABLE */
    /* ========================= */
    .table {
        table-layout: fixed;
    }

        .table td, .table th {
            text-align: center;
            vertical-align: top;
        }

        /* ✅ mỗi cell cao đều */
        .table td {
            height: 130px;
            padding: 6px;
            position: relative;
        }

    /* ========================= */
    /* ✅ CARD TKB */
    /* ========================= */
    .tkb-item {
        display: block;
        width: 100%;
        border-radius: 8px;
        padding: 6px 8px;
        margin-bottom: 5px;
        font-size: 13px;
        line-height: 1.4;
        background: #ffffff;
        border-left: 4px solid #1e88e5;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        transition: all 0.2s ease;
    }

        /* hover đẹp hơn */
        .tkb-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.15);
        }

        /* ========================= */
        /* ✅ TEXT */
        /* ========================= */
        .tkb-item b {
            font-size: 14px;
            color: #222;
        }

        .tkb-item span {
            font-size: 12px;
            color: #555;
        }

    /* ========================= */
    /* ✅ NGHỈ */
    /* ========================= */
    .tkb-nghi {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #ff5252, #c62828);
        color: white;
        font-weight: 600;
        border-radius: 8px;
    }

    /* ========================= */
    /* ✅ CELL TRỐNG */
    /* ========================= */
    .tkb-empty {
        color: #bbb;
        font-size: 14px;
        text-align: center;
        margin-top: 30px;
    }

    /* ========================= */
    /* ✅ LABEL HỌC BÙ */
    /* ========================= */
    .hocbu-label {
        font-size: 11px;
        margin-top: 4px;
        color: #ff9800;
        font-weight: 600;
    }

    /* ========================= */
    /* ✅ TODAY */
    /* ========================= */
    .today-col {
        background-color: #e3f2fd !important;
    }

    /* ========================= */
    /* ✅ HEADER */
    /* ========================= */
    .table thead th {
        background: #f5f7fa;
        font-weight: 600;
    }
    .nav-week {
        display: flex;
        justify-content: flex-end; /* đẩy sang phải */
        gap: 10px;
        margin-bottom: 15px;
    }

        .nav-week button {
            border: none;
            padding: 8px 14px;
            border-radius: 10px;
            background: #3b82f6; /* xanh đẹp */
            color: white;
            font-size: 16px;
            transition: all 0.2s ease;
        }

            /* hover mượt */
            .nav-week button:hover {
                background: #2563eb;
                transform: translateY(-2px);
            }

            /* nhấn */
            .nav-week button:active {
                transform: scale(0.95);
            }

    /* nếu muốn prev khác màu */
    .btn-prev {
        background: #6b7280;
    }

        .btn-prev:hover {
            background: #4b5563;
        }

</style>
<div class="title-wrapper">
    <h2>
        <i class="fas fa-calendar-alt"></i>
        Thời Khóa Biểu
    </h2>
</div>

@if (true)
{
    <hr />

    <!-- HEADER TUẦN -->
    <div class="alert alert-danger fw-bold">
        📅 Lịch học Tuần @Model.Tuan
    </div>

    <!-- NÚT CA + NÚT NEXT -->
    <div class="d-flex justify-content-end mb-3 gap-2">
        <button class="btn btn-outline-secondary" onclick="prevWeek()">
            ⬅ Tuần trước
        </button>

        <button class="btn btn-primary" onclick="nextWeek()">
            Tuần sau ➡
        </button>
    </div>


    <!-- BẢNG TKB -->
    <table class="table table-bordered text-center align-middle">
        <thead>
            <tr>
                <th rowspan="2"></th>


                @for (int thu = 2; thu <= 8; thu++)
                                {
                                    <th>Thứ @(thu == 8 ? "CN" : thu.ToString())</th>
                                }
            </tr>


            <tr>
                @{
                    if (Model.NgayBatDauHoc.HasValue)
                    {
                        DateTime start = Model.NgayBatDauHoc.Value;

                        // ✅ TÍNH THỨ 2 THEO ISO (QUỐC TẾ)
                        int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                        DateTime mondayOfWeek = start.AddDays(-diff);

                        // ✅ CỘNG TUẦN (nếu xem tuần > 1)
                        mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                        for (int i = 0; i < 7; i++)
                        {

                            DateTime today = DateTime.Now.Date;
                            DateTime day = mondayOfWeek.AddDays(i).Date;

                            <th class="@(day == today ? "today-col" : "")">
                                @day.ToString("dd/MM/yyyy")
                            </th>

                        }
                    }
                    else
                    {
                        for (int i = 0; i < 7; i++)
                        {


                        }
                    }
                }
            </tr>
        </thead>

        <tbody>
            @for (int tiet = 1; tiet <= 10; tiet++)
            {

                if (tiet == 6)
                {
                    <tr class="row-ca-chuyen">
                        <td colspan="8">
                            🌙 Buổi chiều (Tiết 6 → 10)
                        </td>
                    </tr>
                }

                <tr>
                    <td><b>Tiết @tiet</b></td>

                    @for (int thu = 2; thu <= 8; thu++)
                    {
                        var list = Model.ThoiKhoaBieus
                            .Where(x => x.Thu == thu && x.TietHoc == tiet)
                            .ToList();

                        //bool laNgayNghi = Model.DsNgayNghi != null
                        //        && Model.DsNgayNghi.Any(n =>
                        //            n.Tuan == Model.Tuan &&
                        //            n.Thu == thu
                        //        );
                        bool laNgayNghi = Model.DsNgayNghi != null
                            && Model.DsNgayNghi.Any(n =>
                                n.Tuan == Model.Tuan &&
                                n.Thu == thu &&
                                n.TietHoc == null       //  nghỉ cả ngày
                            );

                        bool laTietNghi = Model.DsNgayNghi != null
                            && Model.DsNgayNghi.Any(n =>
                                n.Tuan == Model.Tuan &&
                                n.Thu == thu &&
                                n.TietHoc == tiet       //  nghỉ đúng tiết
                            );

                        bool lachieu = Model.CaHoc == "CHIEU";
                        bool laSang = Model.CaHoc == "SANG";


                        bool isChaoCo =
                             thu == 2 &&
                             ((laSang && tiet == 1) || (!laSang && tiet == 10));

                        bool isSinhHoat =
                            thu == 7 &&
                            ((laSang && tiet == 5) || (!laSang && tiet == 10));


                        //in dam ngay hien tai
                        DateTime today = DateTime.Now.Date;
                        // DateTime start = Model.NgayBatDauHoc.Value;
                        DateTime start = Model.NgayBatDauHoc ?? DateTime.Now;


                        int diff = (7 + (start.DayOfWeek - DayOfWeek.Monday)) % 7;
                        DateTime mondayOfWeek = start.AddDays(-diff);
                        mondayOfWeek = mondayOfWeek.AddDays((Model.Tuan - 1) * 7);

                        int index = thu - 2;
                        DateTime day = mondayOfWeek.AddDays(index).Date;

                        <td class="text-start
                    @(laNgayNghi ? "bg-danger text-white" : "")
                    @(day == today ? "today-col" : "")">

                            @{
                                var hocBu = Model.DsHocBu?
                                    .FirstOrDefault(x =>
                                    {
                                        var ngayHocBu = Model.DsNgayHoc
                                            .FirstOrDefault(n => n.NgayHocID == x.NgayHocBuID);

                                        var ngayNghi = Model.DsNgayHoc
                                            .FirstOrDefault(n => n.NgayHocID == x.NgayNghiID);

                                        if (ngayHocBu == null || ngayNghi == null)
                                            return false;

                                        // ✅ nghỉ tiết → match đúng ô
                                        if (ngayNghi.TietHoc != null)
                                        {
                                            return ngayHocBu.Tuan == Model.Tuan
                                                && ngayHocBu.Thu == thu
                                                && ngayHocBu.TietHoc == tiet;
                                        }

                                        // ✅ nghỉ ngày → match theo thứ
                                        return ngayHocBu.Tuan == Model.Tuan
                                            && ngayHocBu.Thu == thu;
                                    });
                            }

                            @* ✅ ƯU TIÊN: nghỉ *@
                            @if (laTietNghi)
                            {
                                <div class="tkb-nghi">🚫 NGHỈ</div>
                            }
                            else if (laNgayNghi)
                            {
                                <div class="tkb-nghi">🚫 NGHỈ</div>
                            }

                            @* ✅ HỌC BÙ *@
                            else if (hocBu != null)
                            {
                                var ngayNghi = Model.DsNgayHoc
                                    .FirstOrDefault(n => n.NgayHocID == hocBu.NgayNghiID);

                                var listHocBu = new List<demomvc.Models.ThoiKhoaBieu>();

                                using (var db2 = new demomvc.Models.QuanLyTruongHocEntities2())
                                {
                                    listHocBu = db2.ThoiKhoaBieu
                                        .Include("PhongHoc")
                                        .Include("LopHoc")
                                        .Include("MonHoc")
                                        .Include("GiaoVien.NguoiDung")
                                        .Where(x =>
                                            x.Tuan == ngayNghi.Tuan &&
                                            x.Thu == ngayNghi.Thu &&
                                            (
                                                // ✅ nghỉ tiết
                                                (ngayNghi.TietHoc != null && x.TietHoc == ngayNghi.TietHoc)

                                                ||

                                                // ✅ nghỉ ngày → map từng tiết
                                                (ngayNghi.TietHoc == null && x.TietHoc == tiet)
                                            )
                                            &&
                                            (
                                                x.LopHocID == Model.LopHocId
                                                || x.GiaoVienID == Model.GiaoVienId
                                            )
                                        )
                                        .ToList();
                                }

                                foreach (var item in listHocBu)
                                {
                                    <div class="tkb-item">

                                        <b>@item.PhongHoc.TenPhong</b><br />
                                        Lớp: <b>@item.LopHoc.TenLop</b><br />
                                        Môn học: @item.MonHoc.TenMonHoc<br />

                                        @if (Model.LaHocSinh)
                                        {
                                            <span>GV: @item.GiaoVien.NguoiDung.HoTen</span>
                                        }

                                        <div style="font-size:11px;color:#ff9800;">
                                            🔁 Học bù
                                        </div>
                                    </div>
                                }
                            }

                            @* ✅ BÌNH THƯỜNG *@
                            else
                            {
                                if (isChaoCo || isSinhHoat)
                                {
                                    <div class="tkb-item">
                                        @if (isChaoCo)
                                        {
                                            <div>⭐ Chào cờ</div>
                                        }
                                        @if (isSinhHoat)
                                        {
                                            <div>⭐ Sinh hoạt lớp</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    foreach (var item in list)
                                    {
                                        <div class="tkb-item">

                                            <b>@item.PhongHoc.TenPhong</b><br />
                                            Lớp: <b>@item.LopHoc.TenLop</b><br />
                                            Môn học: @item.MonHoc.TenMonHoc<br />

                                            @if (Model.LaHocSinh)
                                            {
                                                <span>GV: @item.GiaoVien.NguoiDung.HoTen</span>
                                            }
                                        </div>
                                    }
                                }
                            }

                        </td>
                    }
                </tr>
            }


        </tbody>
    </table>
}
<script>

    $.connection.hub.start();



     function nextWeek() {
     window.location.href =
         '@Url.Action("Index")'
         + '?NamHocID=@Model.NamHocID'
         + '&HocKyID=@Model.HocKyID'
         + '&tuan=' + (@Model.Tuan + 1)
         + '&caHoc=@Model.CaHoc';
    }


  function prevWeek() {

     let tuan = @Model.Tuan;  // lấy từ Razor

     tuan = tuan - 1;

     // ✅ chặn tại đây
     if (tuan < 1) {
         tuan = 1;
     }

     window.location.href =
         '@Url.Action("Index")'
         + '?NamHocID=@Model.NamHocID'
         + '&HocKyID=@Model.HocKyID'
         + '&tuan=' + tuan
         + '&caHoc=@Model.CaHoc';
 }
</script>

